    ∀ Q ∈ invCvPieces, ∀ z ∈ convexHull ℝ (intSet Q),
      (∀ g ∈ convexHull ℝ (intSet invRi), P.Sees g z) ∨ (∀ g ∈ convexHull ℝ (intSet invRj), P.Sees g z) ∨
      (∀ g ∈ convexHull ℝ (intSet invGs), P.Sees g z) ∨ z ∈ convexHull ℝ (intSet invZu) ∨
      z ∈ convexHull ℝ (intSet invCvZn2) := by
  intro Q hQ z hz
  simp only [invCvPieces, List.mem_cons, List.not_mem_nil, or_false] at hQ
