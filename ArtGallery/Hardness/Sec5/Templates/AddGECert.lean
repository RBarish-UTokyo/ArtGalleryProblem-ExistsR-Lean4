/-- `Γ`, guard on `r'_i`: it sees a point of `Γ` iff the point is on or above the line through the guard and `e_i`. -/
theorem addGE_vis_A (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addGEV a) (hS : SepAt P addGEV a addGER) :
    ∀ g ∈ convexHull ℝ (intSet addGERi2), ∀ z ∈ convexHull ℝ (intSet addGEZg),
      (P.Sees g z ↔ det g (intPoint (cv addGEV 48)) z ≤ 0) := by
  intro g hg z hz
  constructor
  · intro hs
    by_contra hc
    push Not at hc
    have hcorner : halfCorner addGEV 47 false = cv addGEV 48 := rfl
    have hh := not_sees_of_chainHalf hP hC (j := 47) (rev := false) (P₁ := addGEZg) (Q₁ := addGERi2)
      (by decide +kernel)
    rw [hcorner] at hh
    exact hh z hz g hg (by rw [← Geometry.det_cyclic]; exact hc) (Polygon.sees_comm.1 hs)
  · intro hr
    have hgate := sees_of_gate (P := P) (convex_convexHull ℝ _) (convex_convexHull ℝ _)
      (addGEGA2_sub hP hL hC hS) (addGEGA1_sub hP hL hC hS) (g₀ := cv addGEV 48) (g₁ := addGEG1A) (P₁ := addGEZg) (Q₁ := addGERi2)
      (hull_subset_hull_of_all (by decide +kernel)) (hull_subset_hull_of_all (by decide +kernel))
      (segment_subset_hull (by decide +kernel) (by decide +kernel))
      (segment_subset_hull (by decide +kernel) (by decide +kernel)) (by decide +kernel)
    exact Polygon.sees_comm.1 (hgate z hz g hg (by rw [← Geometry.det_cyclic]; exact hr))

