    ∀ g ∈ convexHull ℝ (intSet addORRi2), ∀ z ∈ convexHull ℝ (intSet addORZg),
      (P.Sees g z ↔ det g (intPoint (cv addORV 42)) z ≤ 0) := by
  intro g hg z hz
  constructor
  · intro hs
    by_contra hc
    push Not at hc
    have hcorner : halfCorner addORV 41 false = cv addORV 42 := rfl
    have hh := not_sees_of_chainHalf hP hC (j := 41) (rev := false) (P₁ := addORZg) (Q₁ := addORRi2)
      (by decide +kernel)
    rw [hcorner] at hh
    exact hh z hz g hg (by rw [← Geometry.det_cyclic]; exact hc) (Polygon.sees_comm.1 hs)
  · intro hr
    have hgate := sees_of_gate (P := P) (convex_convexHull ℝ _) (convex_convexHull ℝ _)
      (addORGA2_sub hP hL hC hS) (addORGA1_sub hP hL hC hS) (g₀ := cv addORV 42) (g₁ := addORG1A) (P₁ := addORZg) (Q₁ := addORRi2)
      (hull_subset_hull_of_all (by decide +kernel)) (hull_subset_hull_of_all (by decide +kernel))
      (segment_subset_hull (by decide +kernel) (by decide +kernel))
      (segment_subset_hull (by decide +kernel) (by decide +kernel)) (by decide +kernel)
    exact Polygon.sees_comm.1 (hgate z hz g hg (by rw [← Geometry.det_cyclic]; exact hr))

