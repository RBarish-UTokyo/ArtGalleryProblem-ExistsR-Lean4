section Main

variable {P : Polygon} {a : ℕ}
variable (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addLEV a) (hS : SepAt P addLEV a addLER)
include hP hL hC hS

/-- **`Γ` of the le template (paper Lemma 41).**  For values in `[1/2, 2]`, the zone `Γ`
(containing all crossing points of the lines through the guards of `r'_i`, `r_j` and the corners
`e_i`, `e_j`) is seen by the three guards iff `u_C + 5/2 ≤ u_A + u_B`. -/
theorem addLE_gamma_iff {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) :
    (∀ z ∈ convexHull ℝ (intSet addLEZg),
      P.Sees (addLEA u) z ∨ P.Sees (addLEB v) z ∨ P.Sees (addLEC w) z) ↔ w + 5 / 2 ≤ u + v := by
  have hA : ∀ z ∈ convexHull ℝ (intSet addLEZg), P.Sees (addLEA u) z ↔ det (addLEA u) (intPoint addLEEi) z ≤ 0 := by
    intro z hz; rw [← addLEEi_eq]; exact addLE_vis_A hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
  have hB : ∀ z ∈ convexHull ℝ (intSet addLEZg), P.Sees (addLEB v) z ↔ det (addLEB v) (intPoint addLEEj) z ≤ 0 := by
    intro z hz; rw [← addLEEj_eq]; exact addLE_vis_B hP hL hC hS _ (segGuard_mem hv0 hv1) z hz
  have hCC : ∀ z ∈ convexHull ℝ (intSet addLEZg), P.Sees (addLEC w) z ↔ 0 ≤ det (addLEC w) (intPoint addLEEl) z := by
    intro z hz; rw [← addLEEl_eq]; exact addLE_vis_C hP hL hC hS _ (segGuard_mem hw0 hw1) z hz
  have hx := addLE_gamma_x u v w
  have hD : (0 : ℝ) < 24738000 := by norm_num
  constructor
  · intro hall
    by_contra hneg
    push Not at hneg
    set δ := (w + 5 / 2 - u - v) / 7 with hδ
    have hδ0 : 0 < δ := by rw [hδ]; linarith
    have hδ1 : δ ≤ 1 / 2 := by rw [hδ]; linarith
    have hd := addLEDen_pos (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hz := addLEX_mem (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hzA := addLEX_onA (u + δ) (v + δ)
    have hzB := addLEX_onB hd.ne'
    rw [addLEA_shift] at hzA
    rw [addLEB_shift] at hzB
    obtain ⟨h1, h2, h3⟩ := gamma_gap hA hB hCC (addLE_gamma_id u v w) hz (addLEZg_h _ hz)
      (by norm_num [addLEEi, intPoint]) (by norm_num [addLEEj, intPoint])
      (δ := 24738000 * δ) (by positivity) (by rw [hx]; nlinarith) hzA hzB
    rcases hall _ hz with h | h | h
    exacts [h1 h, h2 h, h3 h]
  · intro hle
    have hneg : w + 5 / 2 - u - v ≤ 0 := by linarith
    exact gamma_cover hA hB hCC (addLE_gamma_id u v w) addLEZg_h
      (by nlinarith [mul_nonpos_of_nonneg_of_nonpos hD.le hneg])

/-- **The weak-copy nook of the le template.**  For values `u` on `r_i` and `u'` on `r'_i`
in `[1/2, 2]`, the nook zone is seen by the two guards iff `u' ≤ u`. -/
theorem addLE_nook_iff {u u' : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hu0' : 1 / 2 ≤ u') (hu1' : u' ≤ 2) :
    (∀ z ∈ convexHull ℝ (intSet addLEZn), P.Sees (addLEI u) z ∨ P.Sees (addLEA u') z) ↔ u' ≤ u := by
  have e1 : addLEI u = addLECP.p (u - 1 / 2) := by rw [addLECP_p]; ring_nf
  have e2 : addLEA u' = addLECP.q (u' - 1 / 2) := by rw [addLECP_q]; ring_nf
  rw [e1, e2]
  have key := copyNook_iff (P := P) addLECP addLECP_hyp addLECP_adm (Z := convexHull ℝ (intSet addLEZn))
    (t := u - 1 / 2) (t' := u' - 1 / 2) (by linarith) (by linarith)
    (fun z hz => by
      rw [← e1]
      have := addLE_vis_P hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
      rw [addLEK0_eq] at this
      exact this)
    (fun z hz => by
      rw [← e2]
      have := addLE_vis_Q hP hL hC hS _ (segGuard_mem hu0' hu1') z hz
      rw [addLEK1_eq] at this
      exact this)
    (fun z hz => by
      have := pos_on_hull (Q := addLEZn) (g := (0, 1, -(addLEK0).2)) (by decide +kernel) z hz
      simp only [Corridor.CopyPair.w, addLECP, intPoint_snd]
      simp only [Irrational.HP.val] at this; push_cast at this; linarith)
    (fun z hz => by rw [addLECP_L]; exact zero_on_hull (g := ((-9179529660000000), 25702683048000000, (-22080056939824212000000000))) (by decide +kernel) z hz)
    (fun v h0 h1 => addLECP_Xmem h0 h1)
  rw [key]
  constructor <;> intro h <;> linarith

end Main

/-! ### Cones and W1 -/

section General

variable {P : Polygon} {a : ℕ}

/-- The witness vertices (and the stationary guards). -/
def addLEWit : List ℕ := [5, 14, 9, 10, 26, 35, 30, 31, 51, 60, 55, 56, 39, 1, 18, 21, 43, 46, 70]

/-- **Witness cones (T-cones).** -/
theorem addLE_cone (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addLEV a) {j : ℕ}
    (hj : j ∈ addLEWit) {x : Point} (hs : P.Sees x (intPoint (cv addLEV j))) :
    0 ≤ det (intPoint (cv addLEV (j - 1))) (intPoint (cv addLEV j)) x ∧
      0 ≤ det (intPoint (cv addLEV j)) (intPoint (cv addLEV (j + 1))) x :=
  chain_cone_of_list hP hL hC (by decide +kernel) hj hs

/-- **W1 for `r_i`**: a point seeing its four witnesses lies on `r_i`. -/
theorem addLE_spot_ri (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addLEV a) {x : Point}
    (h1 : P.Sees x (intPoint (cv addLEV 5))) (h2 : P.Sees x (intPoint (cv addLEV 14)))
    (h3 : P.Sees x (intPoint (cv addLEV 9))) (h4 : P.Sees x (intPoint (cv addLEV 10))) :
    x ∈ convexHull ℝ (intSet addLERi) := by
  have c1 := (addLE_cone hP hL hC (by decide) h1).1
  have c2 := (addLE_cone hP hL hC (by decide) h2).1
  have c3 := (addLE_cone hP hL hC (by decide) h3).1
  have c4 := (addLE_cone hP hL hC (by decide) h4).2
  exact spot_of_four (L1 := (cv addLEV 4, cv addLEV 5)) (L2 := (cv addLEV 13, cv addLEV 14))
    (L3 := (cv addLEV 8, cv addLEV 9)) (L4 := (cv addLEV 10, cv addLEV 11))
    (A := ((-544236000), (-371070000))) (B := ((-507129000), (-371070000))) (by decide +kernel) c1 c2 c3 c4

/-- **W1 for `r_l`**: a point seeing its four witnesses lies on `r_l`. -/
theorem addLE_spot_rl (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addLEV a) {x : Point}
    (h1 : P.Sees x (intPoint (cv addLEV 26))) (h2 : P.Sees x (intPoint (cv addLEV 35)))
    (h3 : P.Sees x (intPoint (cv addLEV 30))) (h4 : P.Sees x (intPoint (cv addLEV 31))) :
    x ∈ convexHull ℝ (intSet addLERl) := by
  have c1 := (addLE_cone hP hL hC (by decide) h1).1
  have c2 := (addLE_cone hP hL hC (by decide) h2).1
  have c3 := (addLE_cone hP hL hC (by decide) h3).1
  have c4 := (addLE_cone hP hL hC (by decide) h4).2
  exact spot_of_four (L1 := (cv addLEV 25, cv addLEV 26)) (L2 := (cv addLEV 34, cv addLEV 35))
    (L3 := (cv addLEV 29, cv addLEV 30)) (L4 := (cv addLEV 31, cv addLEV 32))
    (A := (12369000, (-259749000))) (B := (49476000, (-259749000))) (by decide +kernel) c1 c2 c3 c4

/-- **W1 for `r'_i`**: a point seeing its four witnesses lies on `r'_i`. -/
theorem addLE_spot_ri2 (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addLEV a) {x : Point}
    (h1 : P.Sees x (intPoint (cv addLEV 51))) (h2 : P.Sees x (intPoint (cv addLEV 60)))
    (h3 : P.Sees x (intPoint (cv addLEV 55))) (h4 : P.Sees x (intPoint (cv addLEV 56))) :
    x ∈ convexHull ℝ (intSet addLERi2) := by
  have c1 := (addLE_cone hP hL hC (by decide) h1).1
  have c2 := (addLE_cone hP hL hC (by decide) h2).1
  have c3 := (addLE_cone hP hL hC (by decide) h3).1
  have c4 := (addLE_cone hP hL hC (by decide) h4).2
  exact spot_of_four (L1 := (cv addLEV 50, cv addLEV 51)) (L2 := (cv addLEV 59, cv addLEV 60))
    (L3 := (cv addLEV 54, cv addLEV 55)) (L4 := (cv addLEV 56, cv addLEV 57))
    (A := (544236000, 0)) (B := (581343000, 0)) (by decide +kernel) c1 c2 c3 c4

/-- **W1 for `r_j`**: a point seeing its four witnesses lies on `r_j`. -/
theorem addLE_spot_rj (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addLEV a) {x : Point}
    (h1 : P.Sees x (intPoint (cv addLEV 39))) (h2 : P.Sees x (intPoint (cv addLEV 1)))
    (h3 : P.Sees x (intPoint (cv addLEV 18))) (h4 : P.Sees x (intPoint (cv addLEV 21))) :
    x ∈ convexHull ℝ (intSet addLERj) := by
  have c1 := (addLE_cone hP hL hC (by decide) h1).2
  have c2 := (addLE_cone hP hL hC (by decide) h2).2
  have c3 := (addLE_cone hP hL hC (by decide) h3).1
  have c4 := (addLE_cone hP hL hC (by decide) h4).2
  exact spot_of_four (L1 := (cv addLEV 39, cv addLEV 40)) (L2 := (cv addLEV 1, cv addLEV 2))
    (L3 := (cv addLEV 17, cv addLEV 18)) (L4 := (cv addLEV 21, cv addLEV 22))
    (A := ((-581343000), 0)) (B := ((-544236000), 0)) (by decide +kernel) c1 c2 c3 c4

/-- **W1 for the stationary guard `g`** (stationary-guard lemma): the only point seeing both
slot tips is `g`. -/
theorem addLE_spot_g (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addLEV a) {x : Point}
    (ha : P.Sees x (intPoint (cv addLEV 43))) (hb : P.Sees x (intPoint (cv addLEV 46))) :
    x = intPoint (cv addLEV 70) :=
  chain_sg_unique hP hL hC (by decide +kernel) ha hb

end General

