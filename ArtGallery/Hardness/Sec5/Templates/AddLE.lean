theorem addLE_room_Ri (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addLEV a) {x : Point}
    (h : P.Sees (intPoint (cv addLEV 14)) x) : x ∈ addLEKRi.filled := by
  have hR := subList_isRoom hP hL hC (k := 3) (m := 13) (by decide) addLEKRi_simple addLEKRi_ccw
  have hn := n_pos_of_simple hP
  have hv : intPoint (cv addLEV 14) ∈ addLEKRi.filled := by
    have : addLEKRi.vtx 11 = intPoint (cv addLEV 14) := by
      rw [addLEKRi, vtx_map_intPoint, subList_getD (by norm_num)]
    rw [← this]
    exact Or.inl ⟨11, by rw [addLEKRi, n_map_intPoint, subList_length (by decide)]; norm_num,
      Geometry.left_mem_segment _ _⟩
  refine Polygon.sees_mem_room hP hL (i := (a + 14) % P.n) (Nat.mod_lt _ hn)
    (hC.prev_vtx hP (by norm_num) (by decide)) (hC 14 (by decide)) (hC.edge_vtx (by decide)).2
    (by rw [det_intPoint]; exact_mod_cast (show 0 < idet (cv addLEV 13) (cv addLEV 14) (cv addLEV 15) by
      decide +kernel)) hR hv ?_ h
  intro y hy
  refine cone_disjoint_segment_left ?_ ?_ y hy
  · rw [det_intPoint]; exact_mod_cast (show idet (cv addLEV 14) (cv addLEV 15) (cv addLEV 16) < 0 by
      decide +kernel)
  · rw [det_intPoint]; exact_mod_cast (show idet (cv addLEV 14) (cv addLEV 15) (cv addLEV 3) < 0 by
      decide +kernel)

