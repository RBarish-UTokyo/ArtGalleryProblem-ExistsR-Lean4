def addLEKRi : Polygon := ⟨(subList addLEV 3 13).map intPoint⟩

theorem addLEKRi_simple : addLEKRi.Simple := simple_of_simpleCheck (by decide +kernel)

theorem addLEKRi_ccw : addLEKRi.InteriorLeft :=
  interiorLeft_of_supportB addLEKRi_simple (i := 13) (by decide +kernel)

