/-! ### The crossing points `γ(u, v)` -/

/-- Numerator of the crossing parameter. -/
noncomputable def addLENum (u v : ℝ) : ℝ := det (addLEB v) (intPoint addLEEj) (addLEA u)

/-- Denominator of the crossing parameter (positive). -/
noncomputable def addLEDen (u v : ℝ) : ℝ :=
  det (addLEB v) (intPoint addLEEj) (intPoint addLEEi) - addLENum u v

/-- The crossing point `γ(u, v)` of the lines `(addLEA u) e_i` and `(addLEB v) e_j`. -/
noncomputable def addLEX (u v : ℝ) : Point :=
  Geometry.lerp (addLEA u) (intPoint addLEEi) (-addLENum u v / addLEDen u v)

/-- The edge function of the zone edge `Q₁ Q₂` at `γ(u, v)`, times the denominator. -/
noncomputable def addLEBil (Q₁ Q₂ : IPt) (u v : ℝ) : ℝ :=
  det (addLEB v) (intPoint addLEEj) (intPoint addLEEi) * det (intPoint Q₁) (intPoint Q₂) (addLEA u) -
    addLENum u v * det (intPoint Q₁) (intPoint Q₂) (intPoint addLEEi)

theorem addLEBil_hf (Q₁ Q₂ : IPt) : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * addLEBil Q₁ Q₂ x y =
    (5 / 2 - x) * (5 / 2 - y) * addLEBil Q₁ Q₂ (1 / 2) (1 / 2) +
      (x - 1 / 2) * (5 / 2 - y) * addLEBil Q₁ Q₂ (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * addLEBil Q₁ Q₂ (1 / 2) (5 / 2) +
      (x - 1 / 2) * (y - 1 / 2) * addLEBil Q₁ Q₂ (5 / 2) (5 / 2) := by
  intro x y
  simp only [addLEBil, addLENum, det, addLEB, addLEA, segGuard, Geometry.lerp, intPoint]
  ring

theorem addLEDen_hf : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * addLEDen x y =
    (5 / 2 - x) * (5 / 2 - y) * addLEDen (1 / 2) (1 / 2) +
      (x - 1 / 2) * (5 / 2 - y) * addLEDen (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * addLEDen (1 / 2) (5 / 2) +
      (x - 1 / 2) * (y - 1 / 2) * addLEDen (5 / 2) (5 / 2) := by
  intro x y
  simp only [addLEDen, addLENum, det, addLEB, addLEA, segGuard, Geometry.lerp, intPoint]
  ring

/-- Unfold a corner value. -/
macro "addLE_corner" : tactic =>
  `(tactic| (simp only [addLEBil, addLEDen, addLENum, det, addLEB, addLEA, segGuard, Geometry.lerp,
    intPoint, addLEEi, addLEEj, addLEZg0, addLEZg1, addLEZg2, addLEZg3]; norm_num))

theorem addLEDen_pos {x y : ℝ} (hx0 : 1 / 2 ≤ x) (hx1 : x ≤ 5 / 2) (hy0 : 1 / 2 ≤ y)
    (hy1 : y ≤ 5 / 2) : 0 < addLEDen x y :=
  bilin_pos_box (by norm_num) addLEDen addLEDen_hf (by addLE_corner) (by addLE_corner) (by addLE_corner)
    (by addLE_corner) hx0 hx1 hy0 hy1

theorem addLEX_mem {x y : ℝ} (hx0 : 1 / 2 ≤ x) (hx1 : x ≤ 5 / 2) (hy0 : 1 / 2 ≤ y)
    (hy1 : y ≤ 5 / 2) : addLEX x y ∈ convexHull ℝ (intSet addLEZg) := by
  have hd := addLEDen_pos hx0 hx1 hy0 hy1
  have edge : ∀ Q₁ Q₂ : IPt, 0 ≤ addLEBil Q₁ Q₂ (1 / 2) (1 / 2) → 0 ≤ addLEBil Q₁ Q₂ (5 / 2) (1 / 2) →
      0 ≤ addLEBil Q₁ Q₂ (1 / 2) (5 / 2) → 0 ≤ addLEBil Q₁ Q₂ (5 / 2) (5 / 2) →
      0 ≤ det (intPoint Q₁) (intPoint Q₂) (addLEX x y) := by
    intro Q₁ Q₂ h1 h2 h3 h4
    have := bilin_nonneg_box (by norm_num) (addLEBil Q₁ Q₂) (addLEBil_hf Q₁ Q₂) h1 h2 h3 h4 hx0 hx1
      hy0 hy1
    have e : addLEDen x y * det (intPoint Q₁) (intPoint Q₂) (addLEX x y) = addLEBil Q₁ Q₂ x y := by
      rw [addLEX, Geometry.det_lerp, addLEBil]
      have e' : det (addLEB y) (intPoint addLEEj) (intPoint addLEEi) = addLEDen x y + addLENum x y := by
        rw [addLEDen]; ring
      rw [e']
      field_simp
      ring
    rw [← e] at this
    exact nonneg_of_mul_nonneg_right (by linarith) hd
  rw [addLEZg_eq]
  refine mem_hull_quad (A := addLEZg0) (B := addLEZg1) (C := addLEZg2) (D := addLEZg3)
    (by simp) (by simp) (by simp) (by simp) (by decide +kernel) (by decide +kernel)
    (edge _ _ (by addLE_corner) (by addLE_corner) (by addLE_corner) (by addLE_corner))
    (edge _ _ (by addLE_corner) (by addLE_corner) (by addLE_corner) (by addLE_corner))
    (edge _ _ (by addLE_corner) (by addLE_corner) (by addLE_corner) (by addLE_corner))
    (edge _ _ (by addLE_corner) (by addLE_corner) (by addLE_corner) (by addLE_corner))

theorem addLEX_onA (x y : ℝ) : det (addLEA x) (intPoint addLEEi) (addLEX x y) = 0 :=
  Geometry.det_lerp_self _ _ _

theorem addLEX_onB {x y : ℝ} (hd : addLEDen x y ≠ 0) :
    det (addLEB y) (intPoint addLEEj) (addLEX x y) = 0 := by
  rw [addLEX, Geometry.det_lerp]
  have e : det (addLEB y) (intPoint addLEEj) (addLEA x) = addLENum x y := rfl
  rw [e]
  have e2 : det (addLEB y) (intPoint addLEEj) (intPoint addLEEi) = addLENum x y + addLEDen x y := by
    rw [addLEDen]; ring
  rw [e2]
  field_simp
  ring

