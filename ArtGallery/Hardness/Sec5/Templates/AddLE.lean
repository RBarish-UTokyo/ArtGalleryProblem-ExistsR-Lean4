      det (addLEC w) (intPoint addLEEl) z =
      (z.2 - 259749000) * ((addLEC w).1 - (addLEA u).1 - (addLEB v).1) := by
  simp only [addLEA, addLEB, addLEC, segGuard, Geometry.lerp, det, intPoint, addLEEi, addLEEj, addLEEl]
  push_cast; ring

