namespace ArtGallery.Sec5.Tmpl

open ArtGallery Set Polygon Vis.Cert
open ArtGallery.Irrational (HP)

/-- The closed template chain: the chain closed by the mouth `V_last → V₀`. -/
def addGEK : Polygon := Polygon.mk (addGEV.map intPoint)

/-- The mouth of the template: the segment from the last chain vertex back to the first. -/
def addGEMouth : Set Point := ArtGallery.segment (intPoint (cv addGEV 71)) (intPoint (cv addGEV 0))

theorem addGEK_simple : addGEK.Simple := simple_of_simpleCheck (by decide +kernel)

theorem addGEK_ccw : addGEK.InteriorLeft :=
  interiorLeft_of_supportB addGEK_simple (i := 9) (by decide +kernel)

theorem addGEV_subList : subList addGEV 0 71 = addGEV := by decide +kernel

/-- The stationary guard `g`. -/
theorem addGE_g_mem : intPoint (cv addGEV 70) ∈ convexHull ℝ (intSet addGEGs) :=
  mem_intSet_hull (by decide +kernel)

/-- **Completeness** (restated). -/
theorem addGEK_sub_TR : addGEK.filled ⊆ addGETR := addGEK_filled_subset

section Main

variable {P : Polygon} {a : ℕ}

/-- A point seen from a point of the region is in the region. -/
theorem addGE_mem_filled_of_sees {L : List IPt} {g z : Point} (hg : g ∈ convexHull ℝ (intSet L))
    (h : ∀ g ∈ convexHull ℝ (intSet L), P.Sees g z) : z ∈ P.filled :=
  h g hg (by rw [Geometry.segment_comm]; exact Geometry.left_mem_segment _ _)

/-- **The closed template chain is a room of `P` with the mouth as door.** -/
theorem addGE_room (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addGEV a) :
    P.IsRoom addGEK.filled addGEMouth := by
  have h := subList_isRoom hP hL hC (k := 0) (m := 71) (by decide)
    (by rw [addGEV_subList]; exact addGEK_simple) (by rw [addGEV_subList]; exact addGEK_ccw)
  rw [addGEV_subList] at h
  exact h

variable (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addGEV a) (hS : SepAt P addGEV a addGER)
include hP hL hC hS

/-- The enlarged zone `Γ` lies in the region. -/
theorem addGECvZg2_sub : convexHull ℝ (intSet addGECvZg2) ⊆ P.filled :=
  (hull_subset_hull_of_all (by decide +kernel)).trans (addGECvGA2b_sub hP hL hC hS)

/-- The two-dimensional nook zone lies in the region. -/
theorem addGECvZn2_sub : convexHull ℝ (intSet addGECvZn2) ⊆ P.filled :=
  (hull_subset_hull_of_all (by decide +kernel)).trans (addGECvN2b_sub hP hL hC hS)

/-- **The template region lies in the region of `P`.** -/
theorem addGETR_subset : addGETR ⊆ P.filled := by
  rintro z ⟨Q, hQ, hz⟩
  have h1 : (1 / 2 : ℝ) ≤ 1 := by norm_num
  have h2 : (1 : ℝ) ≤ 2 := by norm_num
  rcases addGECv_dispatch hP hL hC hS Q hQ z hz with h | h | h | h | h | h | h
  · exact addGE_mem_filled_of_sees (segGuard_mem h1 h2) h
  · exact addGE_mem_filled_of_sees (segGuard_mem h1 h2) h
  · exact addGE_mem_filled_of_sees (segGuard_mem h1 h2) h
  · exact addGE_mem_filled_of_sees (segGuard_mem h1 h2) h
  · exact addGE_mem_filled_of_sees addGE_g_mem h
  · exact addGECvZg2_sub hP hL hC hS h
  · exact addGECvZn2_sub hP hL hC hS h

/-- **The nook zone.**  With the exact weak copy (the guards of `r_i` and `r'_i` have the same
value), every point of the two-dimensional nook zone is seen by one of the two guards. -/
theorem addGE_cover_Zn2 {u : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) {z : Point}
    (hz : z ∈ convexHull ℝ (intSet addGECvZn2)) : P.Sees (addGEI u) z ∨ P.Sees (addGEA u) z := by
  have e1 : addGEI u = addGECP.p (u - 1 / 2) := by rw [addGECP_p]; ring_nf
  have e2 : addGEA u = addGECP.q (u - 1 / 2) := by rw [addGECP_q]; ring_nf
  have hw : 0 < addGECP.w z := by
    have := pos_on_hull (Q := addGECvZn2) (g := (0, 1, -(addGEK0).2)) (by decide +kernel) z hz
    simp only [Corridor.CopyPair.w, addGECP, intPoint_snd]
    simp only [Irrational.HP.val] at this; push_cast at this; linarith
  have hLz : addGECP.L z ≤ 0 := by
    rw [addGECP_L]
    have := nonneg_on_hull (Q := addGECvZn2) (g := negHP ((-121131046537200000), 308018946908880000, (-885259575023259438288000000))) (by decide +kernel) z hz
    rw [negHP_val] at this; linarith
  rcases Corridor.CopyPair.nook_covered (t := u - 1 / 2) (t' := u - 1 / 2) addGECP_hyp (le_refl _) hw
    hLz with h | h
  · left
    have h' : det (addGEI u) (intPoint (cv addGEV 67)) z ≤ 0 := by rw [addGEK0_eq, e1]; exact h
    exact addGECv_P hP hL hC hS _ (segGuard_mem hu0 hu1) z hz h'
  · right
    have h' : 0 ≤ det (addGEA u) (intPoint (cv addGEV 64)) z := by rw [addGEK1_eq, e2]; exact h
    exact addGECv_Q hP hL hC hS _ (segGuard_mem hu0 hu1) z hz h'

/-- **The zone `Γ`** (paper Lemma 41, on the enlarged zone): under the constraint, every point of
the enlarged zone is seen by one of the three guards of the mechanism. -/
theorem addGE_cover_Zg2 {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) (hc : w ≤ u + v) {z : Point} (hz : z ∈ convexHull ℝ (intSet addGECvZg2)) :
    P.Sees (addGEA u) z ∨ P.Sees (addGEB v) z ∨ P.Sees (addGEC w) z := by
  by_contra hcon
  push Not at hcon
  obtain ⟨h1, h2, h3⟩ := hcon
  have dA : 0 < det (addGEA u) (intPoint addGEEi) z := by
    by_contra h; push Not at h
    exact h1 (addGECv_GA hP hL hC hS _ (segGuard_mem hu0 hu1) z hz (by rw [addGEEi_eq]; exact h))
  have dB : 0 < det (addGEB v) (intPoint addGEEj) z := by
    by_contra h; push Not at h
    exact h2 (addGECv_GB hP hL hC hS _ (segGuard_mem hv0 hv1) z hz (by rw [addGEEj_eq]; exact h))
  have dC : det (addGEC w) (intPoint addGEEl) z < 0 := by
    by_contra h; push Not at h
    exact h3 (addGECv_GC hP hL hC hS _ (segGuard_mem hw0 hw1) z hz (by rw [addGEEl_eq]; exact h))
  have hz2 := pos_on_hull (Q := addGECvZg2) (g := (0, 1, -873570600)) (by decide +kernel) z hz
  simp only [Irrational.HP.val] at hz2
  push_cast at hz2
  have hid := addGE_gamma_id u v w z
  rw [addGE_gamma_x] at hid
  have : (z.2 - 873570600) * (83197200 * (w - u - v)) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (by linarith) (by nlinarith)
  linarith

/-- **T-cover for the ge template.**  For guard values in `[1/2, 2]` with `u_C ≤ u_A + u_B`, every point of the
template region is seen by one of the canonical guards. -/
theorem addGE_cover {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) (hc : w ≤ u + v) :
    ∀ z ∈ addGETR, P.Sees (addGEA u) z ∨ P.Sees (addGEB v) z ∨ P.Sees (addGEC w) z ∨ P.Sees (addGEI u) z ∨
      P.Sees (intPoint (cv addGEV 70)) z := by
  rintro z ⟨Q, hQ, hz⟩
  rcases addGECv_dispatch hP hL hC hS Q hQ z hz with h | h | h | h | h | h | h
  · exact Or.inl (h _ (segGuard_mem hu0 hu1))
  · exact Or.inr (Or.inl (h _ (segGuard_mem hv0 hv1)))
  · exact Or.inr (Or.inr (Or.inl (h _ (segGuard_mem hw0 hw1))))
  · exact Or.inr (Or.inr (Or.inr (Or.inl (h _ (segGuard_mem hu0 hu1)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (h _ addGE_g_mem))))
  · rcases addGE_cover_Zg2 hP hL hC hS hu0 hu1 hv0 hv1 hw0 hw1 hc h with h' | h' | h'
    · exact Or.inl h'
    · exact Or.inr (Or.inl h')
    · exact Or.inr (Or.inr (Or.inl h'))
  · rcases addGE_cover_Zn2 hP hL hC hS hu0 hu1 h with h' | h'
    · exact Or.inr (Or.inr (Or.inr (Or.inl h')))
    · exact Or.inl h'

/-- **T-cover, region form**: every point of the closed template chain is seen. -/
theorem addGE_cover_K {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) (hc : w ≤ u + v) :
    ∀ z ∈ addGEK.filled, P.Sees (addGEA u) z ∨ P.Sees (addGEB v) z ∨ P.Sees (addGEC w) z ∨
      P.Sees (addGEI u) z ∨ P.Sees (intPoint (cv addGEV 70)) z :=
  fun z hz => addGE_cover hP hL hC hS hu0 hu1 hv0 hv1 hw0 hw1 hc z (addGEK_filled_subset hz)

/-- **The mouth is seen by the guard of `r_j`** (any value). -/
theorem addGE_mouth_sees {v : ℝ} (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2) :
    ∀ m ∈ addGEMouth, P.Sees (addGEB v) m := fun m hm =>
  addGECvm_sees hP hL hC hS _ (segGuard_mem hv0 hv1) m
    (segment_subset_hull (by decide +kernel) (by decide +kernel) hm)

/-- **Seeing beyond the mouth**: a point `z` strictly beyond the mouth line, inside the angle at
the guard spanned by the two mouth ends, and seen from every point of the mouth, is seen by the
guard of `r_j`. -/
theorem addGE_sees_beyond_mouth {v : ℝ} (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2) {z : Point}
    (hz : det (intPoint (cv addGEV 71)) (intPoint (cv addGEV 0)) z < 0)
    (h0 : det (addGEB v) z (intPoint (cv addGEV 71)) ≤ 0) (h1 : 0 ≤ det (addGEB v) z (intPoint (cv addGEV 0)))
    (hm : ∀ m ∈ addGEMouth, P.Sees m z) : P.Sees (addGEB v) z := by
  have hp : 0 < det (intPoint (cv addGEV 71)) (intPoint (cv addGEV 0)) (addGEB v) := by
    rw [← lineHP_val]; exact pos_on_hull (by decide +kernel) _ (segGuard_mem hv0 hv1)
  obtain ⟨m, hmM, hmz⟩ := exists_mem_segment_inter (mul_neg_of_pos_of_neg hp hz) h0 h1
  exact sees_of_mem_segment hmz (addGE_mouth_sees hP hL hC hS hv0 hv1 m hmM) (hm m hmM)

