/-! ### The crossing points `γ(u, v)` -/

/-- Numerator of the crossing parameter. -/
noncomputable def addGENum (u v : ℝ) : ℝ := det (addGEB v) (intPoint addGEEj) (addGEA u)

/-- Denominator of the crossing parameter (positive). -/
noncomputable def addGEDen (u v : ℝ) : ℝ :=
  det (addGEB v) (intPoint addGEEj) (intPoint addGEEi) - addGENum u v

/-- The crossing point `γ(u, v)` of the lines `(addGEA u) e_i` and `(addGEB v) e_j`. -/
noncomputable def addGEX (u v : ℝ) : Point :=
  Geometry.lerp (addGEA u) (intPoint addGEEi) (-addGENum u v / addGEDen u v)

/-- The edge function of the zone edge `Q₁ Q₂` at `γ(u, v)`, times the denominator. -/
noncomputable def addGEBil (Q₁ Q₂ : IPt) (u v : ℝ) : ℝ :=
  det (addGEB v) (intPoint addGEEj) (intPoint addGEEi) * det (intPoint Q₁) (intPoint Q₂) (addGEA u) -
    addGENum u v * det (intPoint Q₁) (intPoint Q₂) (intPoint addGEEi)

theorem addGEBil_hf (Q₁ Q₂ : IPt) : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * addGEBil Q₁ Q₂ x y =
    (5 / 2 - x) * (5 / 2 - y) * addGEBil Q₁ Q₂ (1 / 2) (1 / 2) +
      (x - 1 / 2) * (5 / 2 - y) * addGEBil Q₁ Q₂ (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * addGEBil Q₁ Q₂ (1 / 2) (5 / 2) +
      (x - 1 / 2) * (y - 1 / 2) * addGEBil Q₁ Q₂ (5 / 2) (5 / 2) := by
  intro x y
  simp only [addGEBil, addGENum, det, addGEB, addGEA, segGuard, Geometry.lerp, intPoint]
  ring

theorem addGEDen_hf : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * addGEDen x y =
    (5 / 2 - x) * (5 / 2 - y) * addGEDen (1 / 2) (1 / 2) +
      (x - 1 / 2) * (5 / 2 - y) * addGEDen (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * addGEDen (1 / 2) (5 / 2) +
      (x - 1 / 2) * (y - 1 / 2) * addGEDen (5 / 2) (5 / 2) := by
  intro x y
  simp only [addGEDen, addGENum, det, addGEB, addGEA, segGuard, Geometry.lerp, intPoint]
  ring

/-- Unfold a corner value. -/
macro "addGE_corner" : tactic =>
  `(tactic| (simp only [addGEBil, addGEDen, addGENum, det, addGEB, addGEA, segGuard, Geometry.lerp,
    intPoint, addGEEi, addGEEj, addGEZg0, addGEZg1, addGEZg2, addGEZg3]; norm_num))

theorem addGEDen_pos {x y : ℝ} (hx0 : 1 / 2 ≤ x) (hx1 : x ≤ 5 / 2) (hy0 : 1 / 2 ≤ y)
    (hy1 : y ≤ 5 / 2) : 0 < addGEDen x y :=
  bilin_pos_box (by norm_num) addGEDen addGEDen_hf (by addGE_corner) (by addGE_corner) (by addGE_corner)
    (by addGE_corner) hx0 hx1 hy0 hy1

theorem addGEX_mem {x y : ℝ} (hx0 : 1 / 2 ≤ x) (hx1 : x ≤ 5 / 2) (hy0 : 1 / 2 ≤ y)
    (hy1 : y ≤ 5 / 2) : addGEX x y ∈ convexHull ℝ (intSet addGEZg) := by
  have hd := addGEDen_pos hx0 hx1 hy0 hy1
  have edge : ∀ Q₁ Q₂ : IPt, 0 ≤ addGEBil Q₁ Q₂ (1 / 2) (1 / 2) → 0 ≤ addGEBil Q₁ Q₂ (5 / 2) (1 / 2) →
      0 ≤ addGEBil Q₁ Q₂ (1 / 2) (5 / 2) → 0 ≤ addGEBil Q₁ Q₂ (5 / 2) (5 / 2) →
      0 ≤ det (intPoint Q₁) (intPoint Q₂) (addGEX x y) := by
    intro Q₁ Q₂ h1 h2 h3 h4
    have := bilin_nonneg_box (by norm_num) (addGEBil Q₁ Q₂) (addGEBil_hf Q₁ Q₂) h1 h2 h3 h4 hx0 hx1
      hy0 hy1
    have e : addGEDen x y * det (intPoint Q₁) (intPoint Q₂) (addGEX x y) = addGEBil Q₁ Q₂ x y := by
      rw [addGEX, Geometry.det_lerp, addGEBil]
      have e' : det (addGEB y) (intPoint addGEEj) (intPoint addGEEi) = addGEDen x y + addGENum x y := by
        rw [addGEDen]; ring
      rw [e']
      field_simp
      ring
    rw [← e] at this
    exact nonneg_of_mul_nonneg_right (by linarith) hd
  rw [addGEZg_eq]
  refine mem_hull_quad (A := addGEZg0) (B := addGEZg1) (C := addGEZg2) (D := addGEZg3)
    (by simp) (by simp) (by simp) (by simp) (by decide +kernel) (by decide +kernel)
    (edge _ _ (by addGE_corner) (by addGE_corner) (by addGE_corner) (by addGE_corner))
    (edge _ _ (by addGE_corner) (by addGE_corner) (by addGE_corner) (by addGE_corner))
    (edge _ _ (by addGE_corner) (by addGE_corner) (by addGE_corner) (by addGE_corner))
    (edge _ _ (by addGE_corner) (by addGE_corner) (by addGE_corner) (by addGE_corner))

theorem addGEX_onA (x y : ℝ) : det (addGEA x) (intPoint addGEEi) (addGEX x y) = 0 :=
