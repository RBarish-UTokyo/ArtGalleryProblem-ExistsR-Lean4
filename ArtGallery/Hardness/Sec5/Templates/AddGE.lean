/-- **`Γ` of the ge template (paper Lemma 41).**  For values in `[1/2, 2]`, the zone `Γ`
(containing all crossing points of the lines through the guards of `r'_i`, `r_j` and the corners
`e_i`, `e_j`) is seen by the three guards iff `u_C ≤ u_A + u_B`. -/
theorem addGE_gamma_iff {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) :
    (∀ z ∈ convexHull ℝ (intSet addGEZg),
      P.Sees (addGEA u) z ∨ P.Sees (addGEB v) z ∨ P.Sees (addGEC w) z) ↔ w ≤ u + v := by
  have hA : ∀ z ∈ convexHull ℝ (intSet addGEZg), P.Sees (addGEA u) z ↔ det (addGEA u) (intPoint addGEEi) z ≤ 0 := by
    intro z hz; rw [← addGEEi_eq]; exact addGE_vis_A hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
  have hB : ∀ z ∈ convexHull ℝ (intSet addGEZg), P.Sees (addGEB v) z ↔ det (addGEB v) (intPoint addGEEj) z ≤ 0 := by
    intro z hz; rw [← addGEEj_eq]; exact addGE_vis_B hP hL hC hS _ (segGuard_mem hv0 hv1) z hz
  have hCC : ∀ z ∈ convexHull ℝ (intSet addGEZg), P.Sees (addGEC w) z ↔ 0 ≤ det (addGEC w) (intPoint addGEEl) z := by
    intro z hz; rw [← addGEEl_eq]; exact addGE_vis_C hP hL hC hS _ (segGuard_mem hw0 hw1) z hz
  have hx := addGE_gamma_x u v w
  have hD : (0 : ℝ) < 83197200 := by norm_num
  constructor
  · intro hall
    by_contra hneg
    push Not at hneg
    set δ := (w - u - v) / 7 with hδ
    have hδ0 : 0 < δ := by rw [hδ]; linarith
    have hδ1 : δ ≤ 1 / 2 := by rw [hδ]; linarith
    have hd := addGEDen_pos (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hz := addGEX_mem (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hzA := addGEX_onA (u + δ) (v + δ)
    have hzB := addGEX_onB hd.ne'
    rw [addGEA_shift] at hzA
    rw [addGEB_shift] at hzB
    obtain ⟨h1, h2, h3⟩ := gamma_gap hA hB hCC (addGE_gamma_id u v w) hz (addGEZg_h _ hz)
      (by norm_num [addGEEi, intPoint]) (by norm_num [addGEEj, intPoint])
      (δ := 83197200 * δ) (by positivity) (by rw [hx]; nlinarith) hzA hzB
    rcases hall _ hz with h | h | h
    exacts [h1 h, h2 h, h3 h]
  · intro hle
    have hneg : w - u - v ≤ 0 := by linarith
    exact gamma_cover hA hB hCC (addGE_gamma_id u v w) addGEZg_h
      (by nlinarith [mul_nonpos_of_nonneg_of_nonpos hD.le hneg])

/-- **The weak-copy nook of the ge template.**  For values `u` on `r_i` and `u'` on `r'_i`
in `[1/2, 2]`, the nook zone is seen by the two guards iff `u' ≤ u`. -/
theorem addGE_nook_iff {u u' : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hu0' : 1 / 2 ≤ u') (hu1' : u' ≤ 2) :
    (∀ z ∈ convexHull ℝ (intSet addGEZn), P.Sees (addGEI u) z ∨ P.Sees (addGEA u') z) ↔ u' ≤ u := by
  have e1 : addGEI u = addGECP.p (u - 1 / 2) := by rw [addGECP_p]; ring_nf
  have e2 : addGEA u' = addGECP.q (u' - 1 / 2) := by rw [addGECP_q]; ring_nf
  rw [e1, e2]
  have key := copyNook_iff (P := P) addGECP addGECP_hyp addGECP_adm (Z := convexHull ℝ (intSet addGEZn))
    (t := u - 1 / 2) (t' := u' - 1 / 2) (by linarith) (by linarith)
    (fun z hz => by
      rw [← e1]
      have := addGE_vis_P hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
      rw [addGEK0_eq] at this
      exact this)
    (fun z hz => by
      rw [← e2]
      have := addGE_vis_Q hP hL hC hS _ (segGuard_mem hu0' hu1') z hz
      rw [addGEK1_eq] at this
      exact this)
    (fun z hz => by
      have := pos_on_hull (Q := addGEZn) (g := (0, 1, -(addGEK0).2)) (by decide +kernel) z hz
      simp only [Corridor.CopyPair.w, addGECP, intPoint_snd]
      simp only [Irrational.HP.val] at this; push_cast at this; linarith)
    (fun z hz => by rw [addGECP_L]; exact zero_on_hull (g := ((-121131046537200000), 308018946908880000, (-885259575023259438288000000))) (by decide +kernel) z hz)
    (fun v h0 h1 => addGECP_Xmem h0 h1)
  rw [key]
  constructor <;> intro h <;> linarith

end Main

/-! ### Cones and W1 -/

section General

variable {P : Polygon} {a : ℕ}

/-- The witness vertices (and the stationary guards). -/
def addGEWit : List ℕ := [5, 14, 9, 10, 26, 35, 30, 31, 51, 60, 55, 56, 39, 1, 18, 21, 43, 46, 70]

/-- **Witness cones (T-cones).** -/
theorem addGE_cone (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addGEV a) {j : ℕ}
    (hj : j ∈ addGEWit) {x : Point} (hs : P.Sees x (intPoint (cv addGEV j))) :
    0 ≤ det (intPoint (cv addGEV (j - 1))) (intPoint (cv addGEV j)) x ∧
      0 ≤ det (intPoint (cv addGEV j)) (intPoint (cv addGEV (j + 1))) x :=
  chain_cone_of_list hP hL hC (by decide +kernel) hj hs

/-- **W1 for `r_i`**: a point seeing its four witnesses lies on `r_i`. -/
theorem addGE_spot_ri (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addGEV a) {x : Point}
    (h1 : P.Sees x (intPoint (cv addGEV 5))) (h2 : P.Sees x (intPoint (cv addGEV 14)))
    (h3 : P.Sees x (intPoint (cv addGEV 9))) (h4 : P.Sees x (intPoint (cv addGEV 10))) :
    x ∈ convexHull ℝ (intSet addGERi) := by
  have c1 := (addGE_cone hP hL hC (by decide) h1).1
  have c2 := (addGE_cone hP hL hC (by decide) h2).1
  have c3 := (addGE_cone hP hL hC (by decide) h3).1
  have c4 := (addGE_cone hP hL hC (by decide) h4).2
  exact spot_of_four (L1 := (cv addGEV 4, cv addGEV 5)) (L2 := (cv addGEV 13, cv addGEV 14))
    (L3 := (cv addGEV 8, cv addGEV 9)) (L4 := (cv addGEV 10, cv addGEV 11))
    (A := ((-1830338400), (-1455951000))) (B := ((-1705542600), (-1455951000))) (by decide +kernel) c1 c2 c3 c4

/-- **W1 for `r_l`**: a point seeing its four witnesses lies on `r_l`. -/
theorem addGE_spot_rl (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addGEV a) {x : Point}
    (h1 : P.Sees x (intPoint (cv addGEV 26))) (h2 : P.Sees x (intPoint (cv addGEV 35)))
    (h3 : P.Sees x (intPoint (cv addGEV 30))) (h4 : P.Sees x (intPoint (cv addGEV 31))) :
    x ∈ convexHull ℝ (intSet addGERl) := by
  have c1 := (addGE_cone hP hL hC (by decide) h1).1
  have c2 := (addGE_cone hP hL hC (by decide) h2).1
  have c3 := (addGE_cone hP hL hC (by decide) h3).1
  have c4 := (addGE_cone hP hL hC (by decide) h4).2
  exact spot_of_four (L1 := (cv addGEV 25, cv addGEV 26)) (L2 := (cv addGEV 34, cv addGEV 35))
    (L3 := (cv addGEV 29, cv addGEV 30)) (L4 := (cv addGEV 31, cv addGEV 32))
    (A := ((-166394400), (-873570600))) (B := ((-41598600), (-873570600))) (by decide +kernel) c1 c2 c3 c4

/-- **W1 for `r'_i`**: a point seeing its four witnesses lies on `r'_i`. -/
theorem addGE_spot_ri2 (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addGEV a) {x : Point}
    (h1 : P.Sees x (intPoint (cv addGEV 51))) (h2 : P.Sees x (intPoint (cv addGEV 60)))
    (h3 : P.Sees x (intPoint (cv addGEV 55))) (h4 : P.Sees x (intPoint (cv addGEV 56))) :
    x ∈ convexHull ℝ (intSet addGERi2) := by
  have c1 := (addGE_cone hP hL hC (by decide) h1).1
  have c2 := (addGE_cone hP hL hC (by decide) h2).1
  have c3 := (addGE_cone hP hL hC (by decide) h3).1
  have c4 := (addGE_cone hP hL hC (by decide) h4).2
  exact spot_of_four (L1 := (cv addGEV 50, cv addGEV 51)) (L2 := (cv addGEV 59, cv addGEV 60))
    (L3 := (cv addGEV 54, cv addGEV 55)) (L4 := (cv addGEV 56, cv addGEV 57))
    (A := (2038331400, 0)) (B := (2163127200, 0)) (by decide +kernel) c1 c2 c3 c4

/-- **W1 for `r_j`**: a point seeing its four witnesses lies on `r_j`. -/
theorem addGE_spot_rj (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addGEV a) {x : Point}
    (h1 : P.Sees x (intPoint (cv addGEV 39))) (h2 : P.Sees x (intPoint (cv addGEV 1)))
    (h3 : P.Sees x (intPoint (cv addGEV 18))) (h4 : P.Sees x (intPoint (cv addGEV 21))) :
    x ∈ convexHull ℝ (intSet addGERj) := by
  have c1 := (addGE_cone hP hL hC (by decide) h1).2
  have c2 := (addGE_cone hP hL hC (by decide) h2).2
  have c3 := (addGE_cone hP hL hC (by decide) h3).1
  have c4 := (addGE_cone hP hL hC (by decide) h4).2
  exact spot_of_four (L1 := (cv addGEV 39, cv addGEV 40)) (L2 := (cv addGEV 1, cv addGEV 2))
    (L3 := (cv addGEV 17, cv addGEV 18)) (L4 := (cv addGEV 21, cv addGEV 22))
    (A := ((-2163127200), 0)) (B := ((-2038331400), 0)) (by decide +kernel) c1 c2 c3 c4

/-- **W1 for the stationary guard `g`** (stationary-guard lemma): the only point seeing both
slot tips is `g`. -/
theorem addGE_spot_g (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addGEV a) {x : Point}
    (ha : P.Sees x (intPoint (cv addGEV 43))) (hb : P.Sees x (intPoint (cv addGEV 46))) :
    x = intPoint (cv addGEV 70) :=
  chain_sg_unique hP hL hC (by decide +kernel) ha hb

end General

