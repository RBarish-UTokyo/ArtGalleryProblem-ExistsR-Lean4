def addGEKRi : Polygon := ⟨(subList addGEV 3 13).map intPoint⟩

theorem addGEKRi_simple : addGEKRi.Simple := simple_of_simpleCheck (by decide +kernel)

theorem addGEKRi_ccw : addGEKRi.InteriorLeft :=
  interiorLeft_of_supportB addGEKRi_simple (i := 13) (by decide +kernel)

/-- **`V(t1)` of `r_i` lies in its pocket room.** -/
theorem addGE_room_Ri (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addGEV a) {x : Point}
    (h : P.Sees (intPoint (cv addGEV 14)) x) : x ∈ addGEKRi.filled := by
  have hR := subList_isRoom hP hL hC (k := 3) (m := 13) (by decide) addGEKRi_simple addGEKRi_ccw
  have hn := n_pos_of_simple hP
  have hv : intPoint (cv addGEV 14) ∈ addGEKRi.filled := by
    have : addGEKRi.vtx 11 = intPoint (cv addGEV 14) := by
      rw [addGEKRi, vtx_map_intPoint, subList_getD (by norm_num)]
    rw [← this]
    exact Or.inl ⟨11, by rw [addGEKRi, n_map_intPoint, subList_length (by decide)]; norm_num,
      Geometry.left_mem_segment _ _⟩
  refine Polygon.sees_mem_room hP hL (i := (a + 14) % P.n) (Nat.mod_lt _ hn)
    (hC.prev_vtx hP (by norm_num) (by decide)) (hC 14 (by decide)) (hC.edge_vtx (by decide)).2
    (by rw [det_intPoint]; exact_mod_cast (show 0 < idet (cv addGEV 13) (cv addGEV 14) (cv addGEV 15) by
      decide +kernel)) hR hv ?_ h
  intro y hy
  refine cone_disjoint_segment_left ?_ ?_ y hy
  · rw [det_intPoint]; exact_mod_cast (show idet (cv addGEV 14) (cv addGEV 15) (cv addGEV 16) < 0 by
      decide +kernel)
  · rw [det_intPoint]; exact_mod_cast (show idet (cv addGEV 14) (cv addGEV 15) (cv addGEV 3) < 0 by
      decide +kernel)

