/-! ### The crossing points `γ(u, v)` -/

/-- Numerator of the crossing parameter. -/
noncomputable def addORNum (u v : ℝ) : ℝ := det (addORB v) (intPoint addOREj) (addORA u)

/-- Denominator of the crossing parameter (positive). -/
noncomputable def addORDen (u v : ℝ) : ℝ :=
  det (addORB v) (intPoint addOREj) (intPoint addOREi) - addORNum u v

/-- The crossing point `γ(u, v)` of the lines `(addORA u) e_i` and `(addORB v) e_j`. -/
noncomputable def addORX (u v : ℝ) : Point :=
  Geometry.lerp (addORA u) (intPoint addOREi) (-addORNum u v / addORDen u v)

/-- The edge function of the zone edge `Q₁ Q₂` at `γ(u, v)`, times the denominator. -/
noncomputable def addORBil (Q₁ Q₂ : IPt) (u v : ℝ) : ℝ :=
  det (addORB v) (intPoint addOREj) (intPoint addOREi) * det (intPoint Q₁) (intPoint Q₂) (addORA u) -
    addORNum u v * det (intPoint Q₁) (intPoint Q₂) (intPoint addOREi)

theorem addORBil_hf (Q₁ Q₂ : IPt) : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * addORBil Q₁ Q₂ x y =
