/-- **`Γ` of the orient template (paper Lemma 41).**  For values in `[1/2, 2]`, the zone `Γ`
(containing all crossing points of the lines through the guards of `r'_i`, `r_j` and the corners
`e_i`, `e_j`) is seen by the three guards iff `5/2 ≤ u_A + u_B`. -/
theorem addOR_gamma_iff {u v : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
     :
    (∀ z ∈ convexHull ℝ (intSet addORZg),
      P.Sees (addORA u) z ∨ P.Sees (addORB v) z ∨ P.Sees (addORC) z) ↔ 5 / 2 ≤ u + v := by
  have hA : ∀ z ∈ convexHull ℝ (intSet addORZg), P.Sees (addORA u) z ↔ det (addORA u) (intPoint addOREi) z ≤ 0 := by
    intro z hz; rw [← addOREi_eq]; exact addOR_vis_A hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
  have hB : ∀ z ∈ convexHull ℝ (intSet addORZg), P.Sees (addORB v) z ↔ det (addORB v) (intPoint addOREj) z ≤ 0 := by
    intro z hz; rw [← addOREj_eq]; exact addOR_vis_B hP hL hC hS _ (segGuard_mem hv0 hv1) z hz
  have hCC : ∀ z ∈ convexHull ℝ (intSet addORZg), P.Sees (addORC) z ↔ 0 ≤ det (addORC) (intPoint addOREl) z := by
    intro z hz; rw [← addOREl_eq]; exact addOR_vis_C hP hL hC hS _ (subset_convexHull ℝ _ (intPoint_mem_intSet (by simp [addORPs]))) z hz
  have hx := addOR_gamma_x u v
  have hD : (0 : ℝ) < 148879200 := by norm_num
  constructor
  · intro hall
    by_contra hneg
    push Not at hneg
    set δ := (5 / 2 - u - v) / 7 with hδ
    have hδ0 : 0 < δ := by rw [hδ]; linarith
    have hδ1 : δ ≤ 1 / 2 := by rw [hδ]; linarith
    have hd := addORDen_pos (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hz := addORX_mem (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hzA := addORX_onA (u + δ) (v + δ)
    have hzB := addORX_onB hd.ne'
    rw [addORA_shift] at hzA
    rw [addORB_shift] at hzB
    obtain ⟨h1, h2, h3⟩ := gamma_gap hA hB hCC (addOR_gamma_id u v) hz (addORZg_h _ hz)
      (by norm_num [addOREi, intPoint]) (by norm_num [addOREj, intPoint])
      (δ := 148879200 * δ) (by positivity) (by rw [hx]; nlinarith) hzA hzB
    rcases hall _ hz with h | h | h
    exacts [h1 h, h2 h, h3 h]
  · intro hle
    have hneg : 5 / 2 - u - v ≤ 0 := by linarith
    exact gamma_cover hA hB hCC (addOR_gamma_id u v) addORZg_h
      (by nlinarith [mul_nonpos_of_nonneg_of_nonpos hD.le hneg])

/-- **The weak-copy nook of the orient template.**  For values `u` on `r_i` and `u'` on `r'_i`
in `[1/2, 2]`, the nook zone is seen by the two guards iff `u' ≤ u`. -/
theorem addOR_nook_iff {u u' : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hu0' : 1 / 2 ≤ u') (hu1' : u' ≤ 2) :
    (∀ z ∈ convexHull ℝ (intSet addORZn), P.Sees (addORI u) z ∨ P.Sees (addORA u') z) ↔ u' ≤ u := by
  have e1 : addORI u = addORCP.p (u - 1 / 2) := by rw [addORCP_p]; ring_nf
  have e2 : addORA u' = addORCP.q (u' - 1 / 2) := by rw [addORCP_q]; ring_nf
  rw [e1, e2]
  have key := copyNook_iff (P := P) addORCP addORCP_hyp addORCP_adm (Z := convexHull ℝ (intSet addORZn))
    (t := u - 1 / 2) (t' := u' - 1 / 2) (by linarith) (by linarith)
    (fun z hz => by
      rw [← e1]
      have := addOR_vis_P hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
      rw [addORK0_eq] at this
      exact this)
    (fun z hz => by
      rw [← e2]
      have := addOR_vis_Q hP hL hC hS _ (segGuard_mem hu0' hu1') z hz
      rw [addORK1_eq] at this
      exact this)
    (fun z hz => by
      have := pos_on_hull (Q := addORZn) (g := (0, 1, -(addORK0).2)) (by decide +kernel) z hz
      simp only [Corridor.CopyPair.w, addORCP, intPoint_snd]
      simp only [Irrational.HP.val] at this; push_cast at this; linarith)
    (fun z hz => by rw [addORCP_L]; exact zero_on_hull (g := ((-387887783371200000), 986343220572480000, (-5072786461104270150528000000))) (by decide +kernel) z hz)
    (fun v h0 h1 => addORCP_Xmem h0 h1)
  rw [key]
  constructor <;> intro h <;> linarith

end Main

/-! ### Cones and W1 -/

section General

variable {P : Polygon} {a : ℕ}

/-- The witness vertices (and the stationary guards). -/
def addORWit : List ℕ := [5, 14, 9, 10, 45, 54, 49, 50, 33, 1, 18, 21, 37, 40, 64, 25, 28, 31]

/-- **Witness cones (T-cones).** -/
theorem addOR_cone (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addORV a) {j : ℕ}
    (hj : j ∈ addORWit) {x : Point} (hs : P.Sees x (intPoint (cv addORV j))) :
    0 ≤ det (intPoint (cv addORV (j - 1))) (intPoint (cv addORV j)) x ∧
      0 ≤ det (intPoint (cv addORV j)) (intPoint (cv addORV (j + 1))) x :=
  chain_cone_of_list hP hL hC (by decide +kernel) hj hs

/-- **W1 for `r_i`**: a point seeing its four witnesses lies on `r_i`. -/
theorem addOR_spot_ri (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addORV a) {x : Point}
    (h1 : P.Sees x (intPoint (cv addORV 5))) (h2 : P.Sees x (intPoint (cv addORV 14)))
    (h3 : P.Sees x (intPoint (cv addORV 9))) (h4 : P.Sees x (intPoint (cv addORV 10))) :
    x ∈ convexHull ℝ (intSet addORRi) := by
  have c1 := (addOR_cone hP hL hC (by decide) h1).1
  have c2 := (addOR_cone hP hL hC (by decide) h2).1
  have c3 := (addOR_cone hP hL hC (by decide) h3).1
  have c4 := (addOR_cone hP hL hC (by decide) h4).2
  exact spot_of_four (L1 := (cv addORV 4, cv addORV 5)) (L2 := (cv addORV 13, cv addORV 14))
    (L3 := (cv addORV 8, cv addORV 9)) (L4 := (cv addORV 10, cv addORV 11))
    (A := ((-3275342400), (-2605386000))) (B := ((-3052023600), (-2605386000))) (by decide +kernel) c1 c2 c3 c4

/-- **W1 for `r'_i`**: a point seeing its four witnesses lies on `r'_i`. -/
theorem addOR_spot_ri2 (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addORV a) {x : Point}
    (h1 : P.Sees x (intPoint (cv addORV 45))) (h2 : P.Sees x (intPoint (cv addORV 54)))
    (h3 : P.Sees x (intPoint (cv addORV 49))) (h4 : P.Sees x (intPoint (cv addORV 50))) :
    x ∈ convexHull ℝ (intSet addORRi2) := by
  have c1 := (addOR_cone hP hL hC (by decide) h1).1
  have c2 := (addOR_cone hP hL hC (by decide) h2).1
  have c3 := (addOR_cone hP hL hC (by decide) h3).1
  have c4 := (addOR_cone hP hL hC (by decide) h4).2
  exact spot_of_four (L1 := (cv addORV 44, cv addORV 45)) (L2 := (cv addORV 53, cv addORV 54))
    (L3 := (cv addORV 48, cv addORV 49)) (L4 := (cv addORV 50, cv addORV 51))
    (A := (3647540400, 0)) (B := (3870859200, 0)) (by decide +kernel) c1 c2 c3 c4

/-- **W1 for `r_j`**: a point seeing its four witnesses lies on `r_j`. -/
theorem addOR_spot_rj (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addORV a) {x : Point}
    (h1 : P.Sees x (intPoint (cv addORV 33))) (h2 : P.Sees x (intPoint (cv addORV 1)))
    (h3 : P.Sees x (intPoint (cv addORV 18))) (h4 : P.Sees x (intPoint (cv addORV 21))) :
    x ∈ convexHull ℝ (intSet addORRj) := by
  have c1 := (addOR_cone hP hL hC (by decide) h1).2
  have c2 := (addOR_cone hP hL hC (by decide) h2).2
  have c3 := (addOR_cone hP hL hC (by decide) h3).1
  have c4 := (addOR_cone hP hL hC (by decide) h4).2
  exact spot_of_four (L1 := (cv addORV 33, cv addORV 34)) (L2 := (cv addORV 1, cv addORV 2))
    (L3 := (cv addORV 17, cv addORV 18)) (L4 := (cv addORV 21, cv addORV 22))
    (A := ((-3870859200), 0)) (B := ((-3647540400), 0)) (by decide +kernel) c1 c2 c3 c4

/-- **W1 for the stationary guard `g`** (stationary-guard lemma): the only point seeing both
slot tips is `g`. -/
theorem addOR_spot_g (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addORV a) {x : Point}
    (ha : P.Sees x (intPoint (cv addORV 37))) (hb : P.Sees x (intPoint (cv addORV 40))) :
    x = intPoint (cv addORV 64) :=
  chain_sg_unique hP hL hC (by decide +kernel) ha hb

/-- **W1 for the stationary guard `p`** (stationary-guard lemma): the only point seeing both
slot tips is `p`. -/
theorem addOR_spot_p (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addORV a) {x : Point}
    (ha : P.Sees x (intPoint (cv addORV 25))) (hb : P.Sees x (intPoint (cv addORV 28))) :
    x = intPoint (cv addORV 31) :=
  chain_sg_unique hP hL hC (by decide +kernel) ha hb

end General

