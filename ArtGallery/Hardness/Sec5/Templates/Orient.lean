  bilin_pos_box (by norm_num) addORDen addORDen_hf (by addOR_corner) (by addOR_corner) (by addOR_corner)
    (by addOR_corner) hx0 hx1 hy0 hy1

theorem addORX_mem {x y : ℝ} (hx0 : 1 / 2 ≤ x) (hx1 : x ≤ 5 / 2) (hy0 : 1 / 2 ≤ y)
    (hy1 : y ≤ 5 / 2) : addORX x y ∈ convexHull ℝ (intSet addORZg) := by
  have hd := addORDen_pos hx0 hx1 hy0 hy1
  have edge : ∀ Q₁ Q₂ : IPt, 0 ≤ addORBil Q₁ Q₂ (1 / 2) (1 / 2) → 0 ≤ addORBil Q₁ Q₂ (5 / 2) (1 / 2) →
