      0 ≤ det (intPoint Q₁) (intPoint Q₂) (addORX x y) := by
    intro Q₁ Q₂ h1 h2 h3 h4
    have := bilin_nonneg_box (by norm_num) (addORBil Q₁ Q₂) (addORBil_hf Q₁ Q₂) h1 h2 h3 h4 hx0 hx1
      hy0 hy1
