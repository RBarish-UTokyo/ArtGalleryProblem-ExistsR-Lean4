/-- The pocket room of `r_i`: chain vertices `3 … 16`, door `V16 → V3`. -/
def addORKRi : Polygon := ⟨(subList addORV 3 13).map intPoint⟩

theorem addORKRi_simple : addORKRi.Simple := simple_of_simpleCheck (by decide +kernel)

theorem addORKRi_ccw : addORKRi.InteriorLeft :=
  interiorLeft_of_supportB addORKRi_simple (i := 13) (by decide +kernel)

/-- **`V(t1)` of `r_i` lies in its pocket room.** -/
theorem addOR_room_Ri (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addORV a) {x : Point}
    (h : P.Sees (intPoint (cv addORV 14)) x) : x ∈ addORKRi.filled := by
  have hR := subList_isRoom hP hL hC (k := 3) (m := 13) (by decide) addORKRi_simple addORKRi_ccw
  have hn := n_pos_of_simple hP
  have hv : intPoint (cv addORV 14) ∈ addORKRi.filled := by
    have : addORKRi.vtx 11 = intPoint (cv addORV 14) := by
      rw [addORKRi, vtx_map_intPoint, subList_getD (by norm_num)]
    rw [← this]
    exact Or.inl ⟨11, by rw [addORKRi, n_map_intPoint, subList_length (by decide)]; norm_num,
      Geometry.left_mem_segment _ _⟩
  refine Polygon.sees_mem_room hP hL (i := (a + 14) % P.n) (Nat.mod_lt _ hn)
    (hC.prev_vtx hP (by norm_num) (by decide)) (hC 14 (by decide)) (hC.edge_vtx (by decide)).2
    (by rw [det_intPoint]; exact_mod_cast (show 0 < idet (cv addORV 13) (cv addORV 14) (cv addORV 15) by
      decide +kernel)) hR hv ?_ h
  intro y hy
  refine cone_disjoint_segment_left ?_ ?_ y hy
  · rw [det_intPoint]; exact_mod_cast (show idet (cv addORV 14) (cv addORV 15) (cv addORV 16) < 0 by
      decide +kernel)
  · rw [det_intPoint]; exact_mod_cast (show idet (cv addORV 14) (cv addORV 15) (cv addORV 3) < 0 by
      decide +kernel)

