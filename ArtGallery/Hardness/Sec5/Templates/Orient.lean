      (x - 1 / 2) * (5 / 2 - y) * addORBil Q₁ Q₂ (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * addORBil Q₁ Q₂ (1 / 2) (5 / 2) +
      (x - 1 / 2) * (y - 1 / 2) * addORBil Q₁ Q₂ (5 / 2) (5 / 2) := by
  intro x y
  simp only [addORBil, addORNum, det, addORB, addORA, segGuard, Geometry.lerp, intPoint]
  ring

theorem addORDen_hf : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * addORDen x y =
    (5 / 2 - x) * (5 / 2 - y) * addORDen (1 / 2) (1 / 2) +
      (x - 1 / 2) * (5 / 2 - y) * addORDen (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * addORDen (1 / 2) (5 / 2) +
