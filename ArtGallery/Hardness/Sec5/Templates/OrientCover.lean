namespace ArtGallery.Sec5.Tmpl

open ArtGallery Set Polygon Vis.Cert
open ArtGallery.Irrational (HP)

/-- The closed template chain: the chain closed by the mouth `V_last → V₀`. -/
def addORK : Polygon := Polygon.mk (addORV.map intPoint)

/-- The mouth of the template: the segment from the last chain vertex back to the first. -/
def addORMouth : Set Point := ArtGallery.segment (intPoint (cv addORV 65)) (intPoint (cv addORV 0))

theorem addORK_simple : addORK.Simple := simple_of_simpleCheck (by decide +kernel)

theorem addORK_ccw : addORK.InteriorLeft :=
  interiorLeft_of_supportB addORK_simple (i := 9) (by decide +kernel)

theorem addORV_subList : subList addORV 0 65 = addORV := by decide +kernel

/-- The stationary guard `g`. -/
theorem addOR_g_mem : intPoint (cv addORV 64) ∈ convexHull ℝ (intSet addORGs) :=
  mem_intSet_hull (by decide +kernel)

/-- The stationary guard `p`. -/
theorem addOR_p_mem : addORC ∈ convexHull ℝ (intSet addORPs) :=
  mem_intSet_hull (Q := addORPs) (q := (0, (-1563231600))) (by decide +kernel)

/-- **Completeness** (restated). -/
theorem addORK_sub_TR : addORK.filled ⊆ addORTR := addORK_filled_subset

section Main

variable {P : Polygon} {a : ℕ}

/-- A point seen from a point of the region is in the region. -/
theorem addOR_mem_filled_of_sees {L : List IPt} {g z : Point} (hg : g ∈ convexHull ℝ (intSet L))
    (h : ∀ g ∈ convexHull ℝ (intSet L), P.Sees g z) : z ∈ P.filled :=
  h g hg (by rw [Geometry.segment_comm]; exact Geometry.left_mem_segment _ _)

/-- **The closed template chain is a room of `P` with the mouth as door.** -/
theorem addOR_room (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addORV a) :
    P.IsRoom addORK.filled addORMouth := by
  have h := subList_isRoom hP hL hC (k := 0) (m := 65) (by decide)
    (by rw [addORV_subList]; exact addORK_simple) (by rw [addORV_subList]; exact addORK_ccw)
  rw [addORV_subList] at h
  exact h

variable (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P addORV a) (hS : SepAt P addORV a addORR)
include hP hL hC hS

/-- The enlarged zone `Γ` lies in the region. -/
theorem addORCvZg2_sub : convexHull ℝ (intSet addORCvZg2) ⊆ P.filled :=
  (hull_subset_hull_of_all (by decide +kernel)).trans (addORCvGA2b_sub hP hL hC hS)

/-- The two-dimensional nook zone lies in the region. -/
theorem addORCvZn2_sub : convexHull ℝ (intSet addORCvZn2) ⊆ P.filled :=
  (hull_subset_hull_of_all (by decide +kernel)).trans (addORCvN2b_sub hP hL hC hS)

/-- **The template region lies in the region of `P`.** -/
theorem addORTR_subset : addORTR ⊆ P.filled := by
  rintro z ⟨Q, hQ, hz⟩
  have h1 : (1 / 2 : ℝ) ≤ 1 := by norm_num
  have h2 : (1 : ℝ) ≤ 2 := by norm_num
  rcases addORCv_dispatch hP hL hC hS Q hQ z hz with h | h | h | h | h | h | h
  · exact addOR_mem_filled_of_sees (segGuard_mem h1 h2) h
  · exact addOR_mem_filled_of_sees (segGuard_mem h1 h2) h
  · exact addOR_mem_filled_of_sees addOR_p_mem h
  · exact addOR_mem_filled_of_sees (segGuard_mem h1 h2) h
  · exact addOR_mem_filled_of_sees addOR_g_mem h
  · exact addORCvZg2_sub hP hL hC hS h
  · exact addORCvZn2_sub hP hL hC hS h

/-- **The nook zone.**  With the exact weak copy (the guards of `r_i` and `r'_i` have the same
value), every point of the two-dimensional nook zone is seen by one of the two guards. -/
theorem addOR_cover_Zn2 {u : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) {z : Point}
    (hz : z ∈ convexHull ℝ (intSet addORCvZn2)) : P.Sees (addORI u) z ∨ P.Sees (addORA u) z := by
  have e1 : addORI u = addORCP.p (u - 1 / 2) := by rw [addORCP_p]; ring_nf
  have e2 : addORA u = addORCP.q (u - 1 / 2) := by rw [addORCP_q]; ring_nf
  have hw : 0 < addORCP.w z := by
    have := pos_on_hull (Q := addORCvZn2) (g := (0, 1, -(addORK0).2)) (by decide +kernel) z hz
    simp only [Corridor.CopyPair.w, addORCP, intPoint_snd]
    simp only [Irrational.HP.val] at this; push_cast at this; linarith
  have hLz : addORCP.L z ≤ 0 := by
    rw [addORCP_L]
    have := nonneg_on_hull (Q := addORCvZn2) (g := negHP ((-387887783371200000), 986343220572480000, (-5072786461104270150528000000))) (by decide +kernel) z hz
    rw [negHP_val] at this; linarith
  rcases Corridor.CopyPair.nook_covered (t := u - 1 / 2) (t' := u - 1 / 2) addORCP_hyp (le_refl _) hw
    hLz with h | h
  · left
    have h' : det (addORI u) (intPoint (cv addORV 61)) z ≤ 0 := by rw [addORK0_eq, e1]; exact h
    exact addORCv_P hP hL hC hS _ (segGuard_mem hu0 hu1) z hz h'
  · right
    have h' : 0 ≤ det (addORA u) (intPoint (cv addORV 58)) z := by rw [addORK1_eq, e2]; exact h
    exact addORCv_Q hP hL hC hS _ (segGuard_mem hu0 hu1) z hz h'

/-- **The zone `Γ`** (paper Lemma 41, on the enlarged zone): under the constraint, every point of
the enlarged zone is seen by one of the three guards of the mechanism. -/
theorem addOR_cover_Zg2 {u v : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hc : 5 / 2 ≤ u + v) {z : Point} (hz : z ∈ convexHull ℝ (intSet addORCvZg2)) :
    P.Sees (addORA u) z ∨ P.Sees (addORB v) z ∨ P.Sees addORC z := by
  by_contra hcon
  push Not at hcon
  obtain ⟨h1, h2, h3⟩ := hcon
  have dA : 0 < det (addORA u) (intPoint addOREi) z := by
    by_contra h; push Not at h
    exact h1 (addORCv_GA hP hL hC hS _ (segGuard_mem hu0 hu1) z hz (by rw [addOREi_eq]; exact h))
  have dB : 0 < det (addORB v) (intPoint addOREj) z := by
    by_contra h; push Not at h
    exact h2 (addORCv_GB hP hL hC hS _ (segGuard_mem hv0 hv1) z hz (by rw [addOREj_eq]; exact h))
  have dC : det addORC (intPoint addOREl) z < 0 := by
    by_contra h; push Not at h
    exact h3 (addORCv_GC hP hL hC hS _ addOR_p_mem z hz (by rw [addOREl_eq]; exact h))
  have hz2 := pos_on_hull (Q := addORCvZg2) (g := (0, 1, -1563231600)) (by decide +kernel) z hz
  simp only [Irrational.HP.val] at hz2
  push_cast at hz2
  have hid := addOR_gamma_id u v z
  rw [addOR_gamma_x] at hid
  have : (z.2 - 1563231600) * (148879200 * (5 / 2 - u - v)) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (by linarith) (by nlinarith)
  linarith

/-- **T-cover for the orientation template.**  For guard values in `[1/2, 2]` with `u_A + u_B ≥ 5/2`, every point of the
template region is seen by one of the canonical guards. -/
theorem addOR_cover {u v : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hc : 5 / 2 ≤ u + v) :
    ∀ z ∈ addORTR, P.Sees (addORA u) z ∨ P.Sees (addORB v) z ∨ P.Sees addORC z ∨ P.Sees (addORI u) z ∨
      P.Sees (intPoint (cv addORV 64)) z := by
  rintro z ⟨Q, hQ, hz⟩
  rcases addORCv_dispatch hP hL hC hS Q hQ z hz with h | h | h | h | h | h | h
  · exact Or.inl (h _ (segGuard_mem hu0 hu1))
  · exact Or.inr (Or.inl (h _ (segGuard_mem hv0 hv1)))
  · exact Or.inr (Or.inr (Or.inl (h _ addOR_p_mem)))
  · exact Or.inr (Or.inr (Or.inr (Or.inl (h _ (segGuard_mem hu0 hu1)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (h _ addOR_g_mem))))
  · rcases addOR_cover_Zg2 hP hL hC hS hu0 hu1 hv0 hv1 hc h with h' | h' | h'
    · exact Or.inl h'
    · exact Or.inr (Or.inl h')
    · exact Or.inr (Or.inr (Or.inl h'))
  · rcases addOR_cover_Zn2 hP hL hC hS hu0 hu1 h with h' | h'
    · exact Or.inr (Or.inr (Or.inr (Or.inl h')))
    · exact Or.inl h'

/-- **T-cover, region form**: every point of the closed template chain is seen. -/
theorem addOR_cover_K {u v : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hc : 5 / 2 ≤ u + v) :
    ∀ z ∈ addORK.filled, P.Sees (addORA u) z ∨ P.Sees (addORB v) z ∨ P.Sees addORC z ∨
      P.Sees (addORI u) z ∨ P.Sees (intPoint (cv addORV 64)) z :=
  fun z hz => addOR_cover hP hL hC hS hu0 hu1 hv0 hv1 hc z (addORK_filled_subset hz)

/-- **The mouth is seen by the guard of `r_j`** (any value). -/
theorem addOR_mouth_sees {v : ℝ} (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2) :
    ∀ m ∈ addORMouth, P.Sees (addORB v) m := fun m hm =>
  addORCvm_sees hP hL hC hS _ (segGuard_mem hv0 hv1) m
    (segment_subset_hull (by decide +kernel) (by decide +kernel) hm)

/-- **Seeing beyond the mouth**: a point `z` strictly beyond the mouth line, inside the angle at
the guard spanned by the two mouth ends, and seen from every point of the mouth, is seen by the
guard of `r_j`. -/
theorem addOR_sees_beyond_mouth {v : ℝ} (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2) {z : Point}
    (hz : det (intPoint (cv addORV 65)) (intPoint (cv addORV 0)) z < 0)
    (h0 : det (addORB v) z (intPoint (cv addORV 65)) ≤ 0) (h1 : 0 ≤ det (addORB v) z (intPoint (cv addORV 0)))
    (hm : ∀ m ∈ addORMouth, P.Sees m z) : P.Sees (addORB v) z := by
  have hp : 0 < det (intPoint (cv addORV 65)) (intPoint (cv addORV 0)) (addORB v) := by
    rw [← lineHP_val]; exact pos_on_hull (by decide +kernel) _ (segGuard_mem hv0 hv1)
  obtain ⟨m, hmM, hmz⟩ := exists_mem_segment_inter (mul_neg_of_pos_of_neg hp hz) h0 h1
  exact sees_of_mem_segment hmz (addOR_mouth_sees hP hL hC hS hv0 hv1 m hmM) (hm m hmM)

