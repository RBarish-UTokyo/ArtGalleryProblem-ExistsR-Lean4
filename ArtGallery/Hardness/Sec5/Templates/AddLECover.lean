/-- **T-cover for the le template.**  For guard values in `[1/2, 2]` with `u_C + 5/2 ≤ u_A + u_B`, every point of the
template region is seen by one of the canonical guards. -/
theorem addLE_cover {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) (hc : w + 5 / 2 ≤ u + v) :
    ∀ z ∈ addLETR, P.Sees (addLEA u) z ∨ P.Sees (addLEB v) z ∨ P.Sees (addLEC w) z ∨ P.Sees (addLEI u) z ∨
      P.Sees (intPoint (cv addLEV 70)) z := by
  rintro z ⟨Q, hQ, hz⟩
  have hu0' : 1 ≤ u := by linarith
  have hv0' : 1 ≤ v := by linarith
  have hw1' : w ≤ 3 / 2 := by linarith
  rcases addLECv_dispatch hP hL hC hS Q hQ z hz with h | h | h | h | h | h | h
  · exact Or.inl (h _ (addLE_A_mem hu0' hu1))
  · exact Or.inr (Or.inl (h _ (addLE_B_mem hv0' hv1)))
  · exact Or.inr (Or.inr (Or.inl (h _ (addLE_C_mem hw0 hw1'))))
  · exact Or.inr (Or.inr (Or.inr (Or.inl (h _ (addLE_I_mem hu0' hu1)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (h _ addLE_g_mem))))
  · rcases addLE_cover_Zg2 hP hL hC hS hu0 hu1 hv0 hv1 hw0 hw1 hc h with h' | h' | h'
    · exact Or.inl h'
    · exact Or.inr (Or.inl h')
    · exact Or.inr (Or.inr (Or.inl h'))
  · rcases addLE_cover_Zn2 hP hL hC hS hu0 hu1 h with h' | h'
    · exact Or.inr (Or.inr (Or.inr (Or.inl h')))
    · exact Or.inl h'

/-- **T-cover, region form**: every point of the closed template chain is seen. -/
theorem addLE_cover_K {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) (hc : w + 5 / 2 ≤ u + v) :
    ∀ z ∈ addLEK.filled, P.Sees (addLEA u) z ∨ P.Sees (addLEB v) z ∨ P.Sees (addLEC w) z ∨
