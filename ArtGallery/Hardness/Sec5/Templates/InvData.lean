/-- Umbra, guard on `r_i`: it sees a point of the umbra zone iff the point is on or above the line through the guard and `ξ0`. -/
theorem inv_vis_up (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P invV a) (hS : SepAt P invV a invR) :
    ∀ g ∈ convexHull ℝ (intSet invRi), ∀ z ∈ convexHull ℝ (intSet invZu),
      (P.Sees g z ↔ 0 ≤ det g (intPoint (cv invV 14)) z) := by
  intro g hg z hz
  constructor
  · intro hs
    by_contra hc
    push Not at hc
    have hcorner : halfCorner invV 13 false = cv invV 14 := rfl
    have hh := not_sees_of_chainHalf hP hC (j := 13) (rev := false) (P₁ := invRi) (Q₁ := invZu)
      (by decide +kernel)
    rw [hcorner] at hh
    exact hh g hg z hz (by rw [Geometry.det_swap23]; linarith) hs
  · intro hr
    have hgate := sees_of_gate (P := P) (convex_convexHull ℝ _) (convex_convexHull ℝ _)
      (invAp_sub hP hL hC hS) (invBp_sub hP hL hC hS) (g₀ := cv invV 14) (g₁ := invG1u) (P₁ := invRi) (Q₁ := invZu)
      (hull_subset_hull_of_all (by decide +kernel)) (hull_subset_hull_of_all (by decide +kernel))
      (segment_subset_hull (by decide +kernel) (by decide +kernel))
