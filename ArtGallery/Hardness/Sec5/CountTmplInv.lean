    · exact hull_disjoint (L₁ := invGs) (L₂ := invRj) (g := (0, 752243685600, (-2555273075371453118880000))) (by decide +kernel) (by decide +kernel)
    · exact (hull_disjoint (L₁ := invGs) (L₂ := invRi) (g := (0, 752243685600, (-2555273075371453118880000))) (by decide +kernel) (by decide +kernel)).symm
    · exact absurd rfl h
    · exact hull_disjoint (L₁ := invRi) (L₂ := invRj) (g := (0, (-752243685600), 0)) (by decide +kernel) (by decide +kernel)
    · exact (hull_disjoint (L₁ := invGs) (L₂ := invRj) (g := (0, 752243685600, (-2555273075371453118880000))) (by decide +kernel) (by decide +kernel)).symm
    · exact (hull_disjoint (L₁ := invRi) (L₂ := invRj) (g := (0, (-752243685600), 0)) (by decide +kernel) (by decide +kernel)).symm
    · exact absurd rfl h
  spot := by
    intro P a hP hL hC X x hW
    fin_cases X
    · rw [inv_spot_g hP hL hC (hW 16 (by decide)) (hW 20 (by decide))]
      exact subset_convexHull ℝ _ (intPoint_mem_intSet (by decide +kernel))
    · exact inv_spot_ri hP hL hC (hW 2 (by decide)) (hW 11 (by decide)) (hW 6 (by decide)) (hW 7 (by decide))
    · exact inv_spot_rj hP hL hC (hW 24 (by decide)) (hW 33 (by decide)) (hW 28 (by decide)) (hW 29 (by decide))
  disj := by
    intro P a hP hL hC X Y h x h1 h2
    fin_cases X <;> fin_cases Y
    · exact absurd rfl h
    · exact inv_cnt_sep_ri_16 hP hL hC h2 h1
    · exact inv_cnt_sep_rj_16 hP hL hC h2 h1
    · exact inv_cnt_sep_ri_16 hP hL hC h1 h2
    · exact absurd rfl h
    · exact inv_cnt_sep_rj_11 hP hL hC h2 h1
    · exact inv_cnt_sep_rj_16 hP hL hC h1 h2
    · exact inv_cnt_sep_rj_11 hP hL hC h1 h2
    · exact absurd rfl h
  early := by
    intro P a hP hL hC X Y h hr j hj x hx
    fin_cases X <;> fin_cases Y
    · exact absurd rfl h
    · exact absurd hr (by decide)
    · exact absurd hr (by decide)
    · exact inv_cnt_earlyAll_g_ri hP hL hC j hj x hx
    · exact absurd rfl h
