  refine not_sees_of_room hR (w := tpt invV 16) ?_ hx ?_ h2
  · intro hw
    have h3 := filled_subset_hp (subList invV 0 13) (c := ((-3008974742400), 1253739476000, 6161701680828557937920000)) (by decide +kernel)
