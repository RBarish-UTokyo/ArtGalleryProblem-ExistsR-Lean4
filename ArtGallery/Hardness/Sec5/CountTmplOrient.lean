    ∀ y ∈ ArtGallery.segment (entT0 (addORD : ℕ) S) (entT1 (addORD : ℕ) S), ¬ P.Sees y (tpt addORV 54) := by
  have e54 : cv addORV 54 = (4094178000, 0) := by decide +kernel
  have e55 : cv addORV 55 = (4019738400, 7443960) := by decide +kernel
  refine not_sees_seg_cone hP hL hC (j := 54) (by norm_num) (by decide) (by decide +kernel) ?_
  simp only [tpt, show (54 : ℕ) - 1 = 53 from rfl, show (54 : ℕ) + 1 = 55 from rfl, e54, e55,
    intPoint, det, entT0, entT1, addORD]
  push_cast
  right
  constructor <;> nlinarith

