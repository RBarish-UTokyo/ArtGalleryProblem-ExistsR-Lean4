/-- The denominator of the integer template coordinates. -/
def tmplD : Kind → ℕ
  | .ge => 83197200
  | .le => 24738000
  | .orient => 148879200
  | .inv => 501495790400

/-- The template chain (integer template coordinates `D · T`). -/
def tmplV : Kind → List (ℤ × ℤ)
  | .ge => tmplVGE
  | .le => tmplVLE
  | .orient => tmplVOR
  | .inv => tmplVInv

/-- The receivers: template left endpoints `T_τ`. -/
def tmplT : Kind → List Q2
  | .ge => tmplTGE
  | .le => tmplTLE
  | .orient => tmplTOR
  | .inv => tmplTInv

/-- The template point `T = V / D` of an integer template vertex `V`. -/
def tmplPt (k : Kind) (V : ℤ × ℤ) : Q2 := ((V.1 : ℚ) / (tmplD k : ℚ), (V.2 : ℚ) / (tmplD k : ℚ))

