module

public import ArtGallery.Hardness.BP.Templates.OrientCoverCert
public import ArtGallery.Hardness.BP.Templates.Orient

/-!
# Boundary-point templates: the orientation template `AddBP orient` (`u_W + u_B ≥ 5/2`) — coverage by the canonical guards (T-cover)

**Generated by a program that is not included in this repository** (from a fixed text; the data and
the certificates are in `OrientCoverData.lean`).

As in Section 5 (`Sec5/Templates/*Cover.lean`), for the boundary-point layout.
For an arbitrary simple counter-clockwise
polygon `P` containing the template chain (`ChainAt P bpORV a`) whose other edges avoid `bpORR`:

* the **template region** `bpORTR` (a finite union of convex integer pieces) contains the filled
  region of the closed template chain `bpORK` (the chain closed by the **mouth** `bpORMouth`, the
  segment from the last chain vertex `e_j` back to the first one), `bpORK_filled_subset`; `bpORK.filled`
  is a room of `P` with the mouth as door (`bpOR_room`) and `bpORTR ⊆ P.filled` (`bpORTR_subset`);
* **coverage** (`bpOR_cover`): for guard values in `[1/2, 2]` satisfying the constraint `u_A + u_B ≥ 5/2`
  (the guard of `A` having the value `u` of `W`, exact weak copy), every point of `bpORTR` is
  seen by one of the canonical guards: `bpORA u` (`A`), `bpORB v` (`B`), the stationary guard `p = addORC`, `bpORW u`
  (`W`) and the stationary guard `g`.  The zone `Γ` is covered by the mechanism lemma
  `bpOR_cover_Zg2` (the argument of `bpOR_gamma_iff` on a possibly enlarged zone), the nook by the two-dimensional nook zone `bpORCvZn2` (`CopyPair.nook_covered`);
* **the mouth** (`bpOR_mouth_sees`, `bpOR_sees_beyond_mouth`): the guard of `B` sees the mouth,
  hence every point beyond it in the angle of the mouth that is seen from the whole mouth.
-/

@[expose] public section

namespace ArtGallery.BP.Tmpl

open ArtGallery Set Polygon Vis.Cert Sec5.Tmpl
open ArtGallery.Irrational (HP)

/-- The closed template chain: the chain closed by the mouth `V_last → V₀`. -/
def bpORK : Polygon := Polygon.mk (bpORV.map intPoint)

/-- The mouth of the template: the segment from the last chain vertex back to the first. -/
def bpORMouth : Set Point := ArtGallery.segment (intPoint (cv bpORV 62)) (intPoint (cv bpORV 0))

theorem bpORK_simple : bpORK.Simple := simple_of_simpleCheck (by decide +kernel)

theorem bpORK_ccw : bpORK.InteriorLeft :=
  interiorLeft_of_supportB bpORK_simple (i := 53) (by decide +kernel)

theorem bpORV_subList : subList bpORV 0 62 = bpORV := by decide +kernel

/-- The stationary guard `g`. -/
theorem bpOR_g_mem : intPoint (cv bpORV 61) ∈ convexHull ℝ (intSet bpORGs) :=
  mem_intSet_hull (by decide +kernel)

/-- The stationary guard `p`. -/
theorem bpOR_p_mem : bpORC ∈ convexHull ℝ (intSet bpORPs) :=
  mem_intSet_hull (Q := bpORPs) (q := (0, (-2923200))) (by decide +kernel)

/-- **Completeness** (restated). -/
theorem bpORK_sub_TR : bpORK.filled ⊆ bpORTR := bpORK_filled_subset

section Main

variable {P : Polygon} {a : ℕ}

/-- A point seen from a point of the region is in the region. -/
theorem bpOR_mem_filled_of_sees {L : List IPt} {g z : Point} (hg : g ∈ convexHull ℝ (intSet L))
    (h : ∀ g ∈ convexHull ℝ (intSet L), P.Sees g z) : z ∈ P.filled :=
  h g hg (by rw [Geometry.segment_comm]; exact Geometry.left_mem_segment _ _)

/-- **The closed template chain is a room of `P` with the mouth as door.** -/
theorem bpOR_room (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpORV a) :
    P.IsRoom bpORK.filled bpORMouth := by
  have h := subList_isRoom hP hL hC (k := 0) (m := 62) (by decide)
    (by rw [bpORV_subList]; exact bpORK_simple) (by rw [bpORV_subList]; exact bpORK_ccw)
  rw [bpORV_subList] at h
  exact h

variable (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpORV a) (hS : SepAt P bpORV a bpORR)
include hP hL hC hS

/-- The enlarged zone `Γ` lies in the region. -/
theorem bpORCvZg2_sub : convexHull ℝ (intSet bpORCvZg2) ⊆ P.filled :=
  (hull_subset_hull_of_all (by decide +kernel)).trans (bpORCvGA2b_sub hP hL hC hS)

/-- The two-dimensional nook zone lies in the region. -/
theorem bpORCvZn2_sub : convexHull ℝ (intSet bpORCvZn2) ⊆ P.filled :=
  (hull_subset_hull_of_all (by decide +kernel)).trans (bpORCvN2b_sub hP hL hC hS)

/-- **The template region lies in the region of `P`.** -/
theorem bpORTR_subset : bpORTR ⊆ P.filled := by
  rintro z ⟨Q, hQ, hz⟩
  have h1 : (1 / 2 : ℝ) ≤ 1 := by norm_num
  have h2 : (1 : ℝ) ≤ 2 := by norm_num
  rcases bpORCv_dispatch hP hL hC hS Q hQ z hz with h | h | h | h | h | h | h
  · exact bpOR_mem_filled_of_sees (segGuard_mem h1 h2) h
  · exact bpOR_mem_filled_of_sees (segGuard_mem h1 h2) h
  · exact bpOR_mem_filled_of_sees bpOR_p_mem h
  · exact bpOR_mem_filled_of_sees (segGuard_mem h1 h2) h
  · exact bpOR_mem_filled_of_sees bpOR_g_mem h
  · exact bpORCvZg2_sub hP hL hC hS h
  · exact bpORCvZn2_sub hP hL hC hS h

/-- **The nook zone.**  With the exact weak copy (the guards of `W` and `A` have the same
value), every point of the two-dimensional nook zone is seen by one of the two guards. -/
theorem bpOR_cover_Zn2 {u : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) {z : Point}
    (hz : z ∈ convexHull ℝ (intSet bpORCvZn2)) : P.Sees (bpORW u) z ∨ P.Sees (bpORA u) z := by
  have e1 : bpORW u = bpORCP.p (u - 1 / 2) := by rw [bpORCP_p]; ring_nf
  have e2 : bpORA u = bpORCP.q (u - 1 / 2) := by rw [bpORCP_q]; ring_nf
  have hw : 0 < bpORCP.w z := by
    have := pos_on_hull (Q := bpORCvZn2) (g := (0, 1, -(bpORK0).2)) (by decide +kernel) z hz
    simp only [Sec5.Corridor.CopyPair.w, bpORCP, intPoint_snd]
    simp only [Irrational.HP.val] at this; push_cast at this; linarith
  have hLz : bpORCP.L z ≤ 0 := by
    rw [bpORCP_L]
    have := nonneg_on_hull (Q := bpORCvZn2) (g := negHP ((-310026240000), 4495380480000, (-43846143049728000000))) (by decide +kernel) z hz
    rw [negHP_val] at this; linarith
  rcases Sec5.Corridor.CopyPair.nook_covered (t := u - 1 / 2) (t' := u - 1 / 2) bpORCP_hyp (le_refl _) hw
    hLz with h | h
  · left
    have h' : det (bpORW u) (intPoint (cv bpORV 58)) z ≤ 0 := by rw [bpORK0_eq, e1]; exact h
    exact bpORCv_P hP hL hC hS _ (segGuard_mem hu0 hu1) z hz h'
  · right
    have h' : 0 ≤ det (bpORA u) (intPoint (cv bpORV 55)) z := by rw [bpORK1_eq, e2]; exact h
    exact bpORCv_Q hP hL hC hS _ (segGuard_mem hu0 hu1) z hz h'

/-- **The zone `Γ`** (paper Lemma 41, on the enlarged zone): under the constraint, every point of
the enlarged zone is seen by one of the three guards of the mechanism. -/
theorem bpOR_cover_Zg2 {u v : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hc : 5 / 2 ≤ u + v) {z : Point} (hz : z ∈ convexHull ℝ (intSet bpORCvZg2)) :
    P.Sees (bpORA u) z ∨ P.Sees (bpORB v) z ∨ P.Sees bpORC z := by
  by_contra hcon
  push Not at hcon
  obtain ⟨h1, h2, h3⟩ := hcon
  have dA : 0 < det (bpORA u) (intPoint bpOREi) z := by
    by_contra h; push Not at h
    exact h1 (bpORCv_GA hP hL hC hS _ (segGuard_mem hu0 hu1) z hz (by rw [bpOREi_eq]; exact h))
  have dB : 0 < det (bpORB v) (intPoint bpOREj) z := by
    by_contra h; push Not at h
    exact h2 (bpORCv_GB hP hL hC hS _ (segGuard_mem hv0 hv1) z hz (by rw [bpOREj_eq]; exact h))
  have dC : det bpORC (intPoint bpOREl) z < 0 := by
    by_contra h; push Not at h
    exact h3 (bpORCv_GC hP hL hC hS _ bpOR_p_mem z hz (by rw [bpOREl_eq]; exact h))
  have hz2 := pos_on_hull (Q := bpORCvZg2) (g := (0, 1, -2923200)) (by decide +kernel) z hz
  simp only [Irrational.HP.val] at hz2
  push_cast at hz2
  have hid := bpOR_gamma_id u v z
  rw [bpOR_gamma_x] at hid
  have : (z.2 - 2923200) * (278400 * (5 / 2 - u - v)) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (by linarith) (by nlinarith)
  linarith

/-- **T-cover for the orientation template `AddBP orient` (`u_W + u_B ≥ 5/2`).**  For guard values in `[1/2, 2]` with `u_A + u_B ≥ 5/2`, every point of the
template region is seen by one of the canonical guards. -/
theorem bpOR_cover {u v : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hc : 5 / 2 ≤ u + v) :
    ∀ z ∈ bpORTR, P.Sees (bpORA u) z ∨ P.Sees (bpORB v) z ∨ P.Sees bpORC z ∨ P.Sees (bpORW u) z ∨
      P.Sees (intPoint (cv bpORV 61)) z := by
  rintro z ⟨Q, hQ, hz⟩
  rcases bpORCv_dispatch hP hL hC hS Q hQ z hz with h | h | h | h | h | h | h
  · exact Or.inl (h _ (segGuard_mem hu0 hu1))
  · exact Or.inr (Or.inl (h _ (segGuard_mem hv0 hv1)))
  · exact Or.inr (Or.inr (Or.inl (h _ bpOR_p_mem)))
  · exact Or.inr (Or.inr (Or.inr (Or.inl (h _ (segGuard_mem hu0 hu1)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (h _ bpOR_g_mem))))
  · rcases bpOR_cover_Zg2 hP hL hC hS hu0 hu1 hv0 hv1 hc h with h' | h' | h'
    · exact Or.inl h'
    · exact Or.inr (Or.inl h')
    · exact Or.inr (Or.inr (Or.inl h'))
  · rcases bpOR_cover_Zn2 hP hL hC hS hu0 hu1 h with h' | h'
    · exact Or.inr (Or.inr (Or.inr (Or.inl h')))
    · exact Or.inl h'

/-- **T-cover, region form**: every point of the closed template chain is seen. -/
theorem bpOR_cover_K {u v : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hc : 5 / 2 ≤ u + v) :
    ∀ z ∈ bpORK.filled, P.Sees (bpORA u) z ∨ P.Sees (bpORB v) z ∨ P.Sees bpORC z ∨
      P.Sees (bpORW u) z ∨ P.Sees (intPoint (cv bpORV 61)) z :=
  fun z hz => bpOR_cover hP hL hC hS hu0 hu1 hv0 hv1 hc z (bpORK_filled_subset hz)

/-- **The mouth is seen by the guard of `B`** (any value). -/
theorem bpOR_mouth_sees {v : ℝ} (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2) :
    ∀ m ∈ bpORMouth, P.Sees (bpORB v) m := fun m hm =>
  bpORCvm_sees hP hL hC hS _ (segGuard_mem hv0 hv1) m
    (segment_subset_hull (by decide +kernel) (by decide +kernel) hm)

/-- **Seeing beyond the mouth**: a point `z` strictly beyond the mouth line, inside the angle at
the guard spanned by the two mouth ends, and seen from every point of the mouth, is seen by the
guard of `B`. -/
theorem bpOR_sees_beyond_mouth {v : ℝ} (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2) {z : Point}
    (hz : det (intPoint (cv bpORV 62)) (intPoint (cv bpORV 0)) z < 0)
    (h0 : det (bpORB v) z (intPoint (cv bpORV 62)) ≤ 0) (h1 : 0 ≤ det (bpORB v) z (intPoint (cv bpORV 0)))
    (hm : ∀ m ∈ bpORMouth, P.Sees m z) : P.Sees (bpORB v) z := by
  have hp : 0 < det (intPoint (cv bpORV 62)) (intPoint (cv bpORV 0)) (bpORB v) := by
    rw [← lineHP_val]; exact pos_on_hull (by decide +kernel) _ (segGuard_mem hv0 hv1)
  obtain ⟨m, hmM, hmz⟩ := exists_mem_segment_inter (mul_neg_of_pos_of_neg hp hz) h0 h1
  exact sees_of_mem_segment hmz (bpOR_mouth_sees hP hL hC hS hv0 hv1 m hmM) (hm m hmM)

end Main

