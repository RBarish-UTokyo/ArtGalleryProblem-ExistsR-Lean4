      (P.Sees g z ↔ 0 ≤ det g (intPoint (cv bpInvV 12)) z) := by
  intro g hg z hz
  constructor
  · intro hs
    by_contra hc
    push Not at hc
    have hcorner : halfCorner bpInvV 11 false = cv bpInvV 12 := rfl
    have hh := not_sees_of_chainHalf hP hC (j := 11) (rev := false) (P₁ := bpInvRi) (Q₁ := bpInvZu)
      (by decide +kernel)
    rw [hcorner] at hh
    exact hh g hg z hz (by rw [Geometry.det_swap23]; linarith) hs
  · intro hr
    have hgate := sees_of_gate (P := P) (convex_convexHull ℝ _) (convex_convexHull ℝ _)
      (bpInvAp_sub hP hL hC hS) (bpInvBp_sub hP hL hC hS) (g₀ := cv bpInvV 12) (g₁ := bpInvG1u) (P₁ := bpInvRi) (Q₁ := bpInvZu)
      (hull_subset_hull_of_all (by decide +kernel)) (hull_subset_hull_of_all (by decide +kernel))
      (segment_subset_hull (by decide +kernel) (by decide +kernel))
      (segment_subset_hull (by decide +kernel) (by decide +kernel)) (by decide +kernel)
    exact hgate g hg z hz (by rw [Geometry.det_swap23]; linarith)

