module

public import ArtGallery.Hardness.BP.Templates.OrientCert
public import ArtGallery.Hardness.Sec5.Templates.AddCommon

/-!
# Boundary-point templates: the orientation template `AddBP orient` (`u_W + u_B ≥ 5/2`) — template facts

**Generated by a program that is not included in this repository** (the data and certificates are
in `OrientData.lean`, `OrientCert.lean`).

Integer template coordinates (the template point `T` of the boundary-point template
is `bpORD · T`).  All statements are about an arbitrary simple counter-clockwise polygon `P`
containing the template chain (`ChainAt P bpORV a`) whose other edges avoid `bpORR`
(`SepAt P bpORV a bpORR`); `bpORPT` (the chain closed by the fixed stub) is such a polygon.
Guards (values in `[1/2, 2]`, all segments right-oriented, `segGuard`, all on the floors of
bays): `bpORA u` on `A` (the weak copy of `W`), `bpORB v` on `B` (the direct summand),
the stationary guard `bpORC = p` (value `5/2`), `bpORW u` on `W`.

* (T-simple) `bpORPT_simple`, `bpORPT_ccw`, `bpORPT_chain`, `bpORPT_sep`;
* (T-mech) `bpOR_gamma_iff`: `Γ ⊆ V(A) ∪ V(B) ∪ V(C)` iff `5/2 ≤ u_A + u_B` (projection identity
  `bpOR_gamma_id`, paper Lemma 41); `bpOR_nook_iff`: the weak-copy nook of `(W, A)` is covered iff
  `u_A ≤ u_W`.  With `u_A ≤ u_W` (the nook) and `Γ` covered, the relation of the unit holds for
  `u_W` (design: `docs/boundary_point/design.md`, §3.2);
* the counting facts for guards on the boundary are in `CountOrient.lean`.
-/

@[expose] public section

namespace ArtGallery.BP.Tmpl

open ArtGallery Set Polygon Vis.Cert Sec5.Tmpl
open ArtGallery.Irrational (HP)

/-! ### The template polygon -/

/-- The template polygon `P_T`: the chain closed by the stub. -/
def bpORPT : Polygon := ⟨bpORVT.map intPoint⟩

theorem bpORPT_simple : bpORPT.Simple := simple_of_simpleCheck (by decide +kernel)

theorem bpORPT_ccw : bpORPT.InteriorLeft :=
  interiorLeft_of_supportB bpORPT_simple (i := 53) (by decide +kernel)

theorem bpORPT_chain : ChainAt bpORPT bpORV 0 := chainAt_append _ _

theorem bpORPT_sep : SepAt bpORPT bpORV 0 bpORR := sepAt_append (by decide) (by decide +kernel)

/-! ### Guards and the projection identity -/

/-- The guard on `A` with value `u`. -/
noncomputable def bpORA (u : ℝ) : Point := segGuard (10579200, 0) (10996800, 0) u

/-- The guard on `B` with value `v`. -/
noncomputable def bpORB (v : ℝ) : Point := segGuard ((-10996800), 0) ((-10579200), 0) v

/-- The stationary guard `p` (value `5/2` of the removed `C`). -/
noncomputable def bpORC : Point := intPoint (0, (-2923200))

/-- The guard on `W` with value `u`. -/
noncomputable def bpORW (u : ℝ) : Point := segGuard ((-6124800), (-1113600)) ((-5707200), (-1113600)) u

theorem bpORD_real : (bpORD : ℝ) = 278400 := by norm_num [bpORD]

/-- **The projection identity** (paper Lemma 41). -/
theorem bpOR_gamma_id (u v : ℝ) (z : Point) :
    det (bpORA u) (intPoint bpOREi) z + det (bpORB v) (intPoint bpOREj) z -
      det (bpORC) (intPoint bpOREl) z =
      (z.2 - 2923200) * ((bpORC).1 - (bpORA u).1 - (bpORB v).1) := by
  simp only [bpORA, bpORB, bpORC, segGuard, Geometry.lerp, det, intPoint, bpOREi, bpOREj, bpOREl]
  push_cast; ring

theorem bpOR_gamma_x (u v : ℝ) :
    (bpORC).1 - (bpORA u).1 - (bpORB v).1 = 278400 * (5 / 2 - u - v) := by
  simp only [bpORA, bpORB, bpORC, segGuard, Geometry.lerp, intPoint]
  push_cast; ring

theorem bpORA_shift (u δ : ℝ) : bpORA (u + δ) = ((bpORA u).1 + 278400 * δ, (bpORA u).2) := by
  simp only [bpORA, segGuard, Geometry.lerp, intPoint]; push_cast; ext <;> simp only <;> ring

theorem bpORB_shift (v δ : ℝ) : bpORB (v + δ) = ((bpORB v).1 + 278400 * δ, (bpORB v).2) := by
  simp only [bpORB, segGuard, Geometry.lerp, intPoint]; push_cast; ext <;> simp only <;> ring

theorem bpORZg_h : ∀ z ∈ convexHull ℝ (intSet bpORZg), 2923200 < z.2 := by
  intro z hz
  have := pos_on_hull (Q := bpORZg) (g := (0, 1, -2923200)) (by decide +kernel) z hz
  simp only [Irrational.HP.val] at this; push_cast at this; linarith

/-! ### The crossing points `γ(u, v)` -/

/-- Numerator of the crossing parameter. -/
noncomputable def bpORNum (u v : ℝ) : ℝ := det (bpORB v) (intPoint bpOREj) (bpORA u)

/-- Denominator of the crossing parameter (positive). -/
noncomputable def bpORDen (u v : ℝ) : ℝ :=
  det (bpORB v) (intPoint bpOREj) (intPoint bpOREi) - bpORNum u v

/-- The crossing point `γ(u, v)` of the lines `(bpORA u) e_i` and `(bpORB v) e_j`. -/
noncomputable def bpORX (u v : ℝ) : Point :=
  Geometry.lerp (bpORA u) (intPoint bpOREi) (-bpORNum u v / bpORDen u v)

/-- The edge function of the zone edge `Q₁ Q₂` at `γ(u, v)`, times the denominator. -/
noncomputable def bpORBil (Q₁ Q₂ : IPt) (u v : ℝ) : ℝ :=
  det (bpORB v) (intPoint bpOREj) (intPoint bpOREi) * det (intPoint Q₁) (intPoint Q₂) (bpORA u) -
    bpORNum u v * det (intPoint Q₁) (intPoint Q₂) (intPoint bpOREi)

theorem bpORBil_hf (Q₁ Q₂ : IPt) : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * bpORBil Q₁ Q₂ x y =
    (5 / 2 - x) * (5 / 2 - y) * bpORBil Q₁ Q₂ (1 / 2) (1 / 2) +
      (x - 1 / 2) * (5 / 2 - y) * bpORBil Q₁ Q₂ (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * bpORBil Q₁ Q₂ (1 / 2) (5 / 2) +
      (x - 1 / 2) * (y - 1 / 2) * bpORBil Q₁ Q₂ (5 / 2) (5 / 2) := by
  intro x y
  simp only [bpORBil, bpORNum, det, bpORB, bpORA, segGuard, Geometry.lerp, intPoint]
  ring

theorem bpORDen_hf : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * bpORDen x y =
    (5 / 2 - x) * (5 / 2 - y) * bpORDen (1 / 2) (1 / 2) +
      (x - 1 / 2) * (5 / 2 - y) * bpORDen (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * bpORDen (1 / 2) (5 / 2) +
      (x - 1 / 2) * (y - 1 / 2) * bpORDen (5 / 2) (5 / 2) := by
  intro x y
  simp only [bpORDen, bpORNum, det, bpORB, bpORA, segGuard, Geometry.lerp, intPoint]
  ring

/-- Unfold a corner value. -/
macro "bpOR_corner" : tactic =>
  `(tactic| (simp only [bpORBil, bpORDen, bpORNum, det, bpORB, bpORA, segGuard, Geometry.lerp,
    intPoint, bpOREi, bpOREj, bpORZg0, bpORZg1, bpORZg2, bpORZg3]; norm_num))

theorem bpORDen_pos {x y : ℝ} (hx0 : 1 / 2 ≤ x) (hx1 : x ≤ 5 / 2) (hy0 : 1 / 2 ≤ y)
    (hy1 : y ≤ 5 / 2) : 0 < bpORDen x y :=
  bilin_pos_box (by norm_num) bpORDen bpORDen_hf (by bpOR_corner) (by bpOR_corner) (by bpOR_corner)
    (by bpOR_corner) hx0 hx1 hy0 hy1

theorem bpORX_mem {x y : ℝ} (hx0 : 1 / 2 ≤ x) (hx1 : x ≤ 5 / 2) (hy0 : 1 / 2 ≤ y)
    (hy1 : y ≤ 5 / 2) : bpORX x y ∈ convexHull ℝ (intSet bpORZg) := by
  have hd := bpORDen_pos hx0 hx1 hy0 hy1
  have edge : ∀ Q₁ Q₂ : IPt, 0 ≤ bpORBil Q₁ Q₂ (1 / 2) (1 / 2) → 0 ≤ bpORBil Q₁ Q₂ (5 / 2) (1 / 2) →
      0 ≤ bpORBil Q₁ Q₂ (1 / 2) (5 / 2) → 0 ≤ bpORBil Q₁ Q₂ (5 / 2) (5 / 2) →
      0 ≤ det (intPoint Q₁) (intPoint Q₂) (bpORX x y) := by
    intro Q₁ Q₂ h1 h2 h3 h4
    have := bilin_nonneg_box (by norm_num) (bpORBil Q₁ Q₂) (bpORBil_hf Q₁ Q₂) h1 h2 h3 h4 hx0 hx1
      hy0 hy1
    have e : bpORDen x y * det (intPoint Q₁) (intPoint Q₂) (bpORX x y) = bpORBil Q₁ Q₂ x y := by
      rw [bpORX, Geometry.det_lerp, bpORBil]
      have e' : det (bpORB y) (intPoint bpOREj) (intPoint bpOREi) = bpORDen x y + bpORNum x y := by
        rw [bpORDen]; ring
      rw [e']
      field_simp
      ring
    rw [← e] at this
    exact nonneg_of_mul_nonneg_right (by linarith) hd
  rw [bpORZg_eq]
  refine mem_hull_quad (A := bpORZg0) (B := bpORZg1) (C := bpORZg2) (D := bpORZg3)
    (by simp) (by simp) (by simp) (by simp) (by decide +kernel) (by decide +kernel)
    (edge _ _ (by bpOR_corner) (by bpOR_corner) (by bpOR_corner) (by bpOR_corner))
    (edge _ _ (by bpOR_corner) (by bpOR_corner) (by bpOR_corner) (by bpOR_corner))
    (edge _ _ (by bpOR_corner) (by bpOR_corner) (by bpOR_corner) (by bpOR_corner))
    (edge _ _ (by bpOR_corner) (by bpOR_corner) (by bpOR_corner) (by bpOR_corner))

theorem bpORX_onA (x y : ℝ) : det (bpORA x) (intPoint bpOREi) (bpORX x y) = 0 :=
  Geometry.det_lerp_self _ _ _

theorem bpORX_onB {x y : ℝ} (hd : bpORDen x y ≠ 0) :
    det (bpORB y) (intPoint bpOREj) (bpORX x y) = 0 := by
  rw [bpORX, Geometry.det_lerp]
  have e : det (bpORB y) (intPoint bpOREj) (bpORA x) = bpORNum x y := rfl
  rw [e]
  have e2 : det (bpORB y) (intPoint bpOREj) (intPoint bpOREi) = bpORNum x y + bpORDen x y := by
    rw [bpORDen]; ring
  rw [e2]
  field_simp
  ring

/-! ### The weak-copy nook: the copy pair `(W, A)` -/

/-- The copy pair of the weak-copy nook (shadow corners `k0`, `k1`; scale `D`). -/
noncomputable def bpORCP : Sec5.Corridor.CopyPair ℝ :=
  ⟨intPoint bpORK0, intPoint bpORK1, intPoint ((-6124800), (-1113600)), intPoint (10579200, 0), 278400, 278400⟩

theorem bpORCP_hyp : bpORCP.Hyp :=
  ⟨by simp [bpORCP, intPoint, bpORK0, bpORK1], by simp [bpORCP], by simp [bpORCP]⟩

theorem bpORCP_adm : bpORCP.Adm (3 / 2) := by
  refine ⟨by norm_num, ?_, ?_, ?_, ?_, ?_⟩ <;>
    simp only [bpORCP, Sec5.Corridor.CopyPair.p, Sec5.Corridor.CopyPair.q, intPoint, bpORK0, bpORK1] <;> norm_num

theorem bpORCP_p (t : ℝ) : bpORCP.p t = bpORW (t + 1 / 2) := by
  simp only [bpORCP, Sec5.Corridor.CopyPair.p, bpORW, segGuard, Geometry.lerp, intPoint]; push_cast
  ext <;> simp only <;> ring

theorem bpORCP_q (t : ℝ) : bpORCP.q t = bpORA (t + 1 / 2) := by
  simp only [bpORCP, Sec5.Corridor.CopyPair.q, bpORA, segGuard, Geometry.lerp, intPoint]; push_cast
  ext <;> simp only <;> ring

theorem bpORCP_L (z : Point) : bpORCP.L z = Irrational.HP.val (((-310026240000), 4495380480000, (-43846143049728000000))) z := by
  simp only [bpORCP, Sec5.Corridor.CopyPair.L, Sec5.Corridor.det2, intPoint, bpORK0, bpORK1, Irrational.HP.val]
  push_cast; ring

theorem bpORCP_X00 : bpORCP.X 0 0 = Geometry.lerp (intPoint bpORZna) (intPoint bpORZnb) ((23 / 31 : ℝ)) := by
  simp only [Sec5.Corridor.CopyPair.X, Sec5.Corridor.lineInter, Sec5.Corridor.lineDen, Sec5.Corridor.CopyPair.p,
    Sec5.Corridor.CopyPair.q, bpORCP, Geometry.lerp, intPoint, bpORK0, bpORK1, bpORZna, bpORZnb]
  norm_num

theorem bpORCP_Xll : bpORCP.X (3 / 2) (3 / 2) =
    Geometry.lerp (intPoint bpORZna) (intPoint bpORZnb) ((251 / 1057 : ℝ)) := by
  simp only [Sec5.Corridor.CopyPair.X, Sec5.Corridor.lineInter, Sec5.Corridor.lineDen, Sec5.Corridor.CopyPair.p,
    Sec5.Corridor.CopyPair.q, bpORCP, Geometry.lerp, intPoint, bpORK0, bpORK1, bpORZna, bpORZnb]
  norm_num

theorem bpORCP_Xmem {v : ℝ} (h0 : 0 ≤ v) (h1 : v ≤ 3 / 2) :
    bpORCP.X v v ∈ convexHull ℝ (intSet bpORZn) := by
  obtain ⟨α, hα0, hα1, e⟩ := Sec5.Corridor.CopyPair.X_diag_mem bpORCP_hyp bpORCP_adm (by norm_num) h0 h1
  rw [bpORCP_X00, bpORCP_Xll] at e
  have : bpORCP.X v v = Geometry.lerp (intPoint bpORZna) (intPoint bpORZnb)
      ((23 / 31 : ℝ) + α * ((251 / 1057 : ℝ) - (23 / 31 : ℝ))) := by
    rw [e]; simp only [Geometry.lerp]; ext <;> simp only <;> ring
  rw [this, bpORZn_eq]
  exact mem_hull_pair (by nlinarith) (by nlinarith)

/-! ### Main statements -/

section Main

variable {P : Polygon} {a : ℕ}
variable (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpORV a) (hS : SepAt P bpORV a bpORR)
include hP hL hC hS

/-- **`Γ` of the orient template (paper Lemma 41).**  For values in `[1/2, 2]`, the zone `Γ`
(containing all crossing points of the lines through the guards of `A`, `B` and the corners
`e_i`, `e_j`) is seen by the three guards iff `5/2 ≤ u_A + u_B`. -/
theorem bpOR_gamma_iff {u v : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
     :
    (∀ z ∈ convexHull ℝ (intSet bpORZg),
      P.Sees (bpORA u) z ∨ P.Sees (bpORB v) z ∨ P.Sees (bpORC) z) ↔ 5 / 2 ≤ u + v := by
  have hA : ∀ z ∈ convexHull ℝ (intSet bpORZg), P.Sees (bpORA u) z ↔ det (bpORA u) (intPoint bpOREi) z ≤ 0 := by
    intro z hz; rw [← bpOREi_eq]; exact bpOR_vis_A hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
  have hB : ∀ z ∈ convexHull ℝ (intSet bpORZg), P.Sees (bpORB v) z ↔ det (bpORB v) (intPoint bpOREj) z ≤ 0 := by
    intro z hz; rw [← bpOREj_eq]; exact bpOR_vis_B hP hL hC hS _ (segGuard_mem hv0 hv1) z hz
  have hCC : ∀ z ∈ convexHull ℝ (intSet bpORZg), P.Sees (bpORC) z ↔ 0 ≤ det (bpORC) (intPoint bpOREl) z := by
    intro z hz; rw [← bpOREl_eq]; exact bpOR_vis_C hP hL hC hS _ (subset_convexHull ℝ _ (intPoint_mem_intSet (by simp [bpORPs]))) z hz
  have hx := bpOR_gamma_x u v
  have hD : (0 : ℝ) < 278400 := by norm_num
  constructor
  · intro hall
    by_contra hneg
    push Not at hneg
    set δ := (5 / 2 - u - v) / 7 with hδ
    have hδ0 : 0 < δ := by rw [hδ]; linarith
    have hδ1 : δ ≤ 1 / 2 := by rw [hδ]; linarith
    have hd := bpORDen_pos (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hz := bpORX_mem (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hzA := bpORX_onA (u + δ) (v + δ)
    have hzB := bpORX_onB hd.ne'
    rw [bpORA_shift] at hzA
    rw [bpORB_shift] at hzB
    obtain ⟨h1, h2, h3⟩ := gamma_gap hA hB hCC (bpOR_gamma_id u v) hz (bpORZg_h _ hz)
      (by norm_num [bpOREi, intPoint]) (by norm_num [bpOREj, intPoint])
      (δ := 278400 * δ) (by positivity) (by rw [hx]; nlinarith) hzA hzB
    rcases hall _ hz with h | h | h
    exacts [h1 h, h2 h, h3 h]
  · intro hle
    have hneg : 5 / 2 - u - v ≤ 0 := by linarith
    exact gamma_cover hA hB hCC (bpOR_gamma_id u v) bpORZg_h
      (by nlinarith [mul_nonpos_of_nonneg_of_nonpos hD.le hneg])

/-- **The weak-copy nook of the orient template.**  For values `u` on `W` and `u'` on `A`
in `[1/2, 2]`, the nook zone is seen by the two guards iff `u' ≤ u`. -/
theorem bpOR_nook_iff {u u' : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hu0' : 1 / 2 ≤ u') (hu1' : u' ≤ 2) :
    (∀ z ∈ convexHull ℝ (intSet bpORZn), P.Sees (bpORW u) z ∨ P.Sees (bpORA u') z) ↔ u' ≤ u := by
  have e1 : bpORW u = bpORCP.p (u - 1 / 2) := by rw [bpORCP_p]; ring_nf
  have e2 : bpORA u' = bpORCP.q (u' - 1 / 2) := by rw [bpORCP_q]; ring_nf
  rw [e1, e2]
  have key := copyNook_iff (P := P) bpORCP bpORCP_hyp bpORCP_adm (Z := convexHull ℝ (intSet bpORZn))
    (t := u - 1 / 2) (t' := u' - 1 / 2) (by linarith) (by linarith)
    (fun z hz => by
      rw [← e1]
      have := bpOR_vis_P hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
      rw [bpORK0_eq] at this
      exact this)
    (fun z hz => by
      rw [← e2]
      have := bpOR_vis_Q hP hL hC hS _ (segGuard_mem hu0' hu1') z hz
      rw [bpORK1_eq] at this
      exact this)
    (fun z hz => by
      have := pos_on_hull (Q := bpORZn) (g := (0, 1, -(bpORK0).2)) (by decide +kernel) z hz
      simp only [Sec5.Corridor.CopyPair.w, bpORCP, intPoint_snd]
      simp only [Irrational.HP.val] at this; push_cast at this; linarith)
    (fun z hz => by rw [bpORCP_L]; exact zero_on_hull (g := ((-310026240000), 4495380480000, (-43846143049728000000))) (by decide +kernel) z hz)
    (fun v h0 h1 => bpORCP_Xmem h0 h1)
  rw [key]
  constructor <;> intro h <;> linarith

/-- **The relation of the unit.**  If the weak-copy nook is covered by the guards `bpORW u` and
`bpORA u'` and `Γ` by `bpORA u'`, `bpORB v` and the guard of the sum, then `5/2 ≤ u_W + u_B`: the weak copy
satisfies `u' ≤ u`, and `Γ` gives the relation for `u'`. -/
theorem bpOR_relation {u u' v : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hu0' : 1 / 2 ≤ u')
    (hu1' : u' ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hn : ∀ z ∈ convexHull ℝ (intSet bpORZn), P.Sees (bpORW u) z ∨ P.Sees (bpORA u') z)
    (hg : ∀ z ∈ convexHull ℝ (intSet bpORZg),
      P.Sees (bpORA u') z ∨ P.Sees (bpORB v) z ∨ P.Sees (bpORC) z) : 5 / 2 ≤ u + v := by
  have h1 := (bpOR_nook_iff hP hL hC hS hu0 hu1 hu0' hu1').1 hn
  have h2 := (bpOR_gamma_iff hP hL hC hS (u := u') hu0' hu1' hv0 hv1).1 hg
  linarith

end Main

end ArtGallery.BP.Tmpl

end
