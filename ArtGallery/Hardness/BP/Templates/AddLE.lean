module

public import ArtGallery.Hardness.BP.Templates.AddLECert
public import ArtGallery.Hardness.Sec5.Templates.AddCommon

/-!
# Boundary-point templates: the addition template `AddBP le` (`u_W + u_B ≥ u_C + 5/2`) — template facts

**Generated by a program that is not included in this repository** (the data and certificates are
in `AddLEData.lean`, `AddLECert.lean`).

Integer template coordinates (the template point `T` of the boundary-point template
is `bpLED · T`).  All statements are about an arbitrary simple counter-clockwise polygon `P`
containing the template chain (`ChainAt P bpLEV a`) whose other edges avoid `bpLER`
(`SepAt P bpLEV a bpLER`); `bpLEPT` (the chain closed by the fixed stub) is such a polygon.
Guards (values in `[1/2, 2]`, all segments right-oriented, `segGuard`, all on the floors of
bays): `bpLEA u` on `A` (the weak copy of `W`), `bpLEB v` on `B` (the direct summand),
`bpLEC w` on `C` (the sum), `bpLEW u` on `W`.

* (T-simple) `bpLEPT_simple`, `bpLEPT_ccw`, `bpLEPT_chain`, `bpLEPT_sep`;
* (T-mech) `bpLE_gamma_iff`: `Γ ⊆ V(A) ∪ V(B) ∪ V(C)` iff `u_C + 5/2 ≤ u_A + u_B` (projection identity
  `bpLE_gamma_id`, paper Lemma 41); `bpLE_nook_iff`: the weak-copy nook of `(W, A)` is covered iff
  `u_A ≤ u_W`.  With `u_A ≤ u_W` (the nook) and `Γ` covered, the relation of the unit holds for
  `u_W` (design: `docs/boundary_point/design.md`, §3.2);
* the counting facts for guards on the boundary are in `CountAddLE.lean`.
-/

@[expose] public section

namespace ArtGallery.BP.Tmpl

open ArtGallery Set Polygon Vis.Cert Sec5.Tmpl
open ArtGallery.Irrational (HP)

/-! ### The template polygon -/

/-- The template polygon `P_T`: the chain closed by the stub. -/
def bpLEPT : Polygon := ⟨bpLEVT.map intPoint⟩

theorem bpLEPT_simple : bpLEPT.Simple := simple_of_simpleCheck (by decide +kernel)

theorem bpLEPT_ccw : bpLEPT.InteriorLeft :=
  interiorLeft_of_lowB bpLEPT_simple (i := 30) (by decide +kernel)

theorem bpLEPT_chain : ChainAt bpLEPT bpLEV 0 := chainAt_append _ _

theorem bpLEPT_sep : SepAt bpLEPT bpLEV 0 bpLER := sepAt_append (by decide) (by decide +kernel)

/-! ### Guards and the projection identity -/

/-- The guard on `A` with value `u`. -/
noncomputable def bpLEA (u : ℝ) : Point := segGuard (12609600, 0) (13142400, 0) u

/-- The guard on `B` with value `v`. -/
noncomputable def bpLEB (v : ℝ) : Point := segGuard ((-13142400), 0) ((-12609600), 0) v

/-- The guard on `C` with value `w`. -/
noncomputable def bpLEC (w : ℝ) : Point := segGuard (177600, (-3729600)) (710400, (-3729600)) w

/-- The guard on `W` with value `u`. -/
noncomputable def bpLEW (u : ℝ) : Point := segGuard ((-7814400), (-532800)) ((-7281600), (-532800)) u

theorem bpLED_real : (bpLED : ℝ) = 355200 := by norm_num [bpLED]

/-- **The projection identity** (paper Lemma 41). -/
theorem bpLE_gamma_id (u v w : ℝ) (z : Point) :
    det (bpLEA u) (intPoint bpLEEi) z + det (bpLEB v) (intPoint bpLEEj) z -
      det (bpLEC w) (intPoint bpLEEl) z =
      (z.2 - 3729600) * ((bpLEC w).1 - (bpLEA u).1 - (bpLEB v).1) := by
  simp only [bpLEA, bpLEB, bpLEC, segGuard, Geometry.lerp, det, intPoint, bpLEEi, bpLEEj, bpLEEl]
  push_cast; ring

theorem bpLE_gamma_x (u v w : ℝ) :
    (bpLEC w).1 - (bpLEA u).1 - (bpLEB v).1 = 355200 * (w + 5 / 2 - u - v) := by
  simp only [bpLEA, bpLEB, bpLEC, segGuard, Geometry.lerp, intPoint]
  push_cast; ring

theorem bpLEA_shift (u δ : ℝ) : bpLEA (u + δ) = ((bpLEA u).1 + 355200 * δ, (bpLEA u).2) := by
  simp only [bpLEA, segGuard, Geometry.lerp, intPoint]; push_cast; ext <;> simp only <;> ring

theorem bpLEB_shift (v δ : ℝ) : bpLEB (v + δ) = ((bpLEB v).1 + 355200 * δ, (bpLEB v).2) := by
  simp only [bpLEB, segGuard, Geometry.lerp, intPoint]; push_cast; ext <;> simp only <;> ring

theorem bpLEZg_h : ∀ z ∈ convexHull ℝ (intSet bpLEZg), 3729600 < z.2 := by
  intro z hz
  have := pos_on_hull (Q := bpLEZg) (g := (0, 1, -3729600)) (by decide +kernel) z hz
  simp only [Irrational.HP.val] at this; push_cast at this; linarith

/-! ### The crossing points `γ(u, v)` -/

/-- Numerator of the crossing parameter. -/
noncomputable def bpLENum (u v : ℝ) : ℝ := det (bpLEB v) (intPoint bpLEEj) (bpLEA u)

/-- Denominator of the crossing parameter (positive). -/
noncomputable def bpLEDen (u v : ℝ) : ℝ :=
  det (bpLEB v) (intPoint bpLEEj) (intPoint bpLEEi) - bpLENum u v

/-- The crossing point `γ(u, v)` of the lines `(bpLEA u) e_i` and `(bpLEB v) e_j`. -/
noncomputable def bpLEX (u v : ℝ) : Point :=
  Geometry.lerp (bpLEA u) (intPoint bpLEEi) (-bpLENum u v / bpLEDen u v)

/-- The edge function of the zone edge `Q₁ Q₂` at `γ(u, v)`, times the denominator. -/
noncomputable def bpLEBil (Q₁ Q₂ : IPt) (u v : ℝ) : ℝ :=
  det (bpLEB v) (intPoint bpLEEj) (intPoint bpLEEi) * det (intPoint Q₁) (intPoint Q₂) (bpLEA u) -
    bpLENum u v * det (intPoint Q₁) (intPoint Q₂) (intPoint bpLEEi)

theorem bpLEBil_hf (Q₁ Q₂ : IPt) : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * bpLEBil Q₁ Q₂ x y =
    (5 / 2 - x) * (5 / 2 - y) * bpLEBil Q₁ Q₂ (1 / 2) (1 / 2) +
      (x - 1 / 2) * (5 / 2 - y) * bpLEBil Q₁ Q₂ (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * bpLEBil Q₁ Q₂ (1 / 2) (5 / 2) +
      (x - 1 / 2) * (y - 1 / 2) * bpLEBil Q₁ Q₂ (5 / 2) (5 / 2) := by
  intro x y
  simp only [bpLEBil, bpLENum, det, bpLEB, bpLEA, segGuard, Geometry.lerp, intPoint]
  ring

theorem bpLEDen_hf : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * bpLEDen x y =
    (5 / 2 - x) * (5 / 2 - y) * bpLEDen (1 / 2) (1 / 2) +
      (x - 1 / 2) * (5 / 2 - y) * bpLEDen (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * bpLEDen (1 / 2) (5 / 2) +
      (x - 1 / 2) * (y - 1 / 2) * bpLEDen (5 / 2) (5 / 2) := by
  intro x y
  simp only [bpLEDen, bpLENum, det, bpLEB, bpLEA, segGuard, Geometry.lerp, intPoint]
  ring

/-- Unfold a corner value. -/
macro "bpLE_corner" : tactic =>
  `(tactic| (simp only [bpLEBil, bpLEDen, bpLENum, det, bpLEB, bpLEA, segGuard, Geometry.lerp,
    intPoint, bpLEEi, bpLEEj, bpLEZg0, bpLEZg1, bpLEZg2, bpLEZg3]; norm_num))

theorem bpLEDen_pos {x y : ℝ} (hx0 : 1 / 2 ≤ x) (hx1 : x ≤ 5 / 2) (hy0 : 1 / 2 ≤ y)
    (hy1 : y ≤ 5 / 2) : 0 < bpLEDen x y :=
  bilin_pos_box (by norm_num) bpLEDen bpLEDen_hf (by bpLE_corner) (by bpLE_corner) (by bpLE_corner)
    (by bpLE_corner) hx0 hx1 hy0 hy1

theorem bpLEX_mem {x y : ℝ} (hx0 : 1 / 2 ≤ x) (hx1 : x ≤ 5 / 2) (hy0 : 1 / 2 ≤ y)
    (hy1 : y ≤ 5 / 2) : bpLEX x y ∈ convexHull ℝ (intSet bpLEZg) := by
  have hd := bpLEDen_pos hx0 hx1 hy0 hy1
  have edge : ∀ Q₁ Q₂ : IPt, 0 ≤ bpLEBil Q₁ Q₂ (1 / 2) (1 / 2) → 0 ≤ bpLEBil Q₁ Q₂ (5 / 2) (1 / 2) →
      0 ≤ bpLEBil Q₁ Q₂ (1 / 2) (5 / 2) → 0 ≤ bpLEBil Q₁ Q₂ (5 / 2) (5 / 2) →
      0 ≤ det (intPoint Q₁) (intPoint Q₂) (bpLEX x y) := by
    intro Q₁ Q₂ h1 h2 h3 h4
    have := bilin_nonneg_box (by norm_num) (bpLEBil Q₁ Q₂) (bpLEBil_hf Q₁ Q₂) h1 h2 h3 h4 hx0 hx1
      hy0 hy1
    have e : bpLEDen x y * det (intPoint Q₁) (intPoint Q₂) (bpLEX x y) = bpLEBil Q₁ Q₂ x y := by
      rw [bpLEX, Geometry.det_lerp, bpLEBil]
      have e' : det (bpLEB y) (intPoint bpLEEj) (intPoint bpLEEi) = bpLEDen x y + bpLENum x y := by
        rw [bpLEDen]; ring
      rw [e']
      field_simp
      ring
    rw [← e] at this
    exact nonneg_of_mul_nonneg_right (by linarith) hd
  rw [bpLEZg_eq]
  refine mem_hull_quad (A := bpLEZg0) (B := bpLEZg1) (C := bpLEZg2) (D := bpLEZg3)
    (by simp) (by simp) (by simp) (by simp) (by decide +kernel) (by decide +kernel)
    (edge _ _ (by bpLE_corner) (by bpLE_corner) (by bpLE_corner) (by bpLE_corner))
    (edge _ _ (by bpLE_corner) (by bpLE_corner) (by bpLE_corner) (by bpLE_corner))
    (edge _ _ (by bpLE_corner) (by bpLE_corner) (by bpLE_corner) (by bpLE_corner))
    (edge _ _ (by bpLE_corner) (by bpLE_corner) (by bpLE_corner) (by bpLE_corner))

theorem bpLEX_onA (x y : ℝ) : det (bpLEA x) (intPoint bpLEEi) (bpLEX x y) = 0 :=
  Geometry.det_lerp_self _ _ _

theorem bpLEX_onB {x y : ℝ} (hd : bpLEDen x y ≠ 0) :
    det (bpLEB y) (intPoint bpLEEj) (bpLEX x y) = 0 := by
  rw [bpLEX, Geometry.det_lerp]
  have e : det (bpLEB y) (intPoint bpLEEj) (bpLEA x) = bpLENum x y := rfl
  rw [e]
  have e2 : det (bpLEB y) (intPoint bpLEEj) (intPoint bpLEEi) = bpLENum x y + bpLEDen x y := by
    rw [bpLEDen]; ring
  rw [e2]
  field_simp
  ring

/-! ### The weak-copy nook: the copy pair `(W, A)` -/

/-- The copy pair of the weak-copy nook (shadow corners `k0`, `k1`; scale `D`). -/
noncomputable def bpLECP : Sec5.Corridor.CopyPair ℝ :=
  ⟨intPoint bpLEK0, intPoint bpLEK1, intPoint ((-7814400), (-532800)), intPoint (12609600, 0), 355200, 355200⟩

theorem bpLECP_hyp : bpLECP.Hyp :=
  ⟨by simp [bpLECP, intPoint, bpLEK0, bpLEK1], by simp [bpLECP], by simp [bpLECP]⟩

theorem bpLECP_adm : bpLECP.Adm (3 / 2) := by
  refine ⟨by norm_num, ?_, ?_, ?_, ?_, ?_⟩ <;>
    simp only [bpLECP, Sec5.Corridor.CopyPair.p, Sec5.Corridor.CopyPair.q, intPoint, bpLEK0, bpLEK1] <;> norm_num

theorem bpLECP_p (t : ℝ) : bpLECP.p t = bpLEW (t + 1 / 2) := by
  simp only [bpLECP, Sec5.Corridor.CopyPair.p, bpLEW, segGuard, Geometry.lerp, intPoint]; push_cast
  ext <;> simp only <;> ring

theorem bpLECP_q (t : ℝ) : bpLECP.q t = bpLEA (t + 1 / 2) := by
  simp only [bpLECP, Sec5.Corridor.CopyPair.q, bpLEA, segGuard, Geometry.lerp, intPoint]; push_cast
  ext <;> simp only <;> ring

theorem bpLECP_L (z : Point) : bpLECP.L z = Irrational.HP.val (((-189250560000), 7002270720000, (-87477967650816000000))) z := by
  simp only [bpLECP, Sec5.Corridor.CopyPair.L, Sec5.Corridor.det2, intPoint, bpLEK0, bpLEK1, Irrational.HP.val]
  push_cast; ring

theorem bpLECP_X00 : bpLECP.X 0 0 = Geometry.lerp (intPoint bpLEZna) (intPoint bpLEZnb) ((4835 / 5158 : ℝ)) := by
  simp only [Sec5.Corridor.CopyPair.X, Sec5.Corridor.lineInter, Sec5.Corridor.lineDen, Sec5.Corridor.CopyPair.p,
    Sec5.Corridor.CopyPair.q, bpLECP, Geometry.lerp, intPoint, bpLEK0, bpLEK1, bpLEZna, bpLEZnb]
  norm_num

theorem bpLECP_Xll : bpLECP.X (3 / 2) (3 / 2) =
    Geometry.lerp (intPoint bpLEZna) (intPoint bpLEZnb) ((1035 / 2582 : ℝ)) := by
  simp only [Sec5.Corridor.CopyPair.X, Sec5.Corridor.lineInter, Sec5.Corridor.lineDen, Sec5.Corridor.CopyPair.p,
    Sec5.Corridor.CopyPair.q, bpLECP, Geometry.lerp, intPoint, bpLEK0, bpLEK1, bpLEZna, bpLEZnb]
  norm_num

theorem bpLECP_Xmem {v : ℝ} (h0 : 0 ≤ v) (h1 : v ≤ 3 / 2) :
    bpLECP.X v v ∈ convexHull ℝ (intSet bpLEZn) := by
  obtain ⟨α, hα0, hα1, e⟩ := Sec5.Corridor.CopyPair.X_diag_mem bpLECP_hyp bpLECP_adm (by norm_num) h0 h1
  rw [bpLECP_X00, bpLECP_Xll] at e
  have : bpLECP.X v v = Geometry.lerp (intPoint bpLEZna) (intPoint bpLEZnb)
      ((4835 / 5158 : ℝ) + α * ((1035 / 2582 : ℝ) - (4835 / 5158 : ℝ))) := by
    rw [e]; simp only [Geometry.lerp]; ext <;> simp only <;> ring
  rw [this, bpLEZn_eq]
  exact mem_hull_pair (by nlinarith) (by nlinarith)

/-! ### Main statements -/

section Main

variable {P : Polygon} {a : ℕ}
variable (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpLEV a) (hS : SepAt P bpLEV a bpLER)
include hP hL hC hS

/-- **`Γ` of the le template (paper Lemma 41).**  For values in `[1/2, 2]`, the zone `Γ`
(containing all crossing points of the lines through the guards of `A`, `B` and the corners
`e_i`, `e_j`) is seen by the three guards iff `u_C + 5/2 ≤ u_A + u_B`. -/
theorem bpLE_gamma_iff {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) :
    (∀ z ∈ convexHull ℝ (intSet bpLEZg),
      P.Sees (bpLEA u) z ∨ P.Sees (bpLEB v) z ∨ P.Sees (bpLEC w) z) ↔ w + 5 / 2 ≤ u + v := by
  have hA : ∀ z ∈ convexHull ℝ (intSet bpLEZg), P.Sees (bpLEA u) z ↔ det (bpLEA u) (intPoint bpLEEi) z ≤ 0 := by
    intro z hz; rw [← bpLEEi_eq]; exact bpLE_vis_A hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
  have hB : ∀ z ∈ convexHull ℝ (intSet bpLEZg), P.Sees (bpLEB v) z ↔ det (bpLEB v) (intPoint bpLEEj) z ≤ 0 := by
    intro z hz; rw [← bpLEEj_eq]; exact bpLE_vis_B hP hL hC hS _ (segGuard_mem hv0 hv1) z hz
  have hCC : ∀ z ∈ convexHull ℝ (intSet bpLEZg), P.Sees (bpLEC w) z ↔ 0 ≤ det (bpLEC w) (intPoint bpLEEl) z := by
    intro z hz; rw [← bpLEEl_eq]; exact bpLE_vis_C hP hL hC hS _ (segGuard_mem hw0 hw1) z hz
  have hx := bpLE_gamma_x u v w
  have hD : (0 : ℝ) < 355200 := by norm_num
  constructor
  · intro hall
    by_contra hneg
    push Not at hneg
    set δ := (w + 5 / 2 - u - v) / 7 with hδ
    have hδ0 : 0 < δ := by rw [hδ]; linarith
    have hδ1 : δ ≤ 1 / 2 := by rw [hδ]; linarith
    have hd := bpLEDen_pos (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hz := bpLEX_mem (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hzA := bpLEX_onA (u + δ) (v + δ)
    have hzB := bpLEX_onB hd.ne'
    rw [bpLEA_shift] at hzA
    rw [bpLEB_shift] at hzB
    obtain ⟨h1, h2, h3⟩ := gamma_gap hA hB hCC (bpLE_gamma_id u v w) hz (bpLEZg_h _ hz)
      (by norm_num [bpLEEi, intPoint]) (by norm_num [bpLEEj, intPoint])
      (δ := 355200 * δ) (by positivity) (by rw [hx]; nlinarith) hzA hzB
    rcases hall _ hz with h | h | h
    exacts [h1 h, h2 h, h3 h]
  · intro hle
    have hneg : w + 5 / 2 - u - v ≤ 0 := by linarith
    exact gamma_cover hA hB hCC (bpLE_gamma_id u v w) bpLEZg_h
      (by nlinarith [mul_nonpos_of_nonneg_of_nonpos hD.le hneg])

/-- **The weak-copy nook of the le template.**  For values `u` on `W` and `u'` on `A`
in `[1/2, 2]`, the nook zone is seen by the two guards iff `u' ≤ u`. -/
theorem bpLE_nook_iff {u u' : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hu0' : 1 / 2 ≤ u') (hu1' : u' ≤ 2) :
    (∀ z ∈ convexHull ℝ (intSet bpLEZn), P.Sees (bpLEW u) z ∨ P.Sees (bpLEA u') z) ↔ u' ≤ u := by
  have e1 : bpLEW u = bpLECP.p (u - 1 / 2) := by rw [bpLECP_p]; ring_nf
  have e2 : bpLEA u' = bpLECP.q (u' - 1 / 2) := by rw [bpLECP_q]; ring_nf
  rw [e1, e2]
  have key := copyNook_iff (P := P) bpLECP bpLECP_hyp bpLECP_adm (Z := convexHull ℝ (intSet bpLEZn))
    (t := u - 1 / 2) (t' := u' - 1 / 2) (by linarith) (by linarith)
    (fun z hz => by
      rw [← e1]
      have := bpLE_vis_P hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
      rw [bpLEK0_eq] at this
      exact this)
    (fun z hz => by
      rw [← e2]
      have := bpLE_vis_Q hP hL hC hS _ (segGuard_mem hu0' hu1') z hz
      rw [bpLEK1_eq] at this
      exact this)
    (fun z hz => by
      have := pos_on_hull (Q := bpLEZn) (g := (0, 1, -(bpLEK0).2)) (by decide +kernel) z hz
      simp only [Sec5.Corridor.CopyPair.w, bpLECP, intPoint_snd]
      simp only [Irrational.HP.val] at this; push_cast at this; linarith)
    (fun z hz => by rw [bpLECP_L]; exact zero_on_hull (g := ((-189250560000), 7002270720000, (-87477967650816000000))) (by decide +kernel) z hz)
    (fun v h0 h1 => bpLECP_Xmem h0 h1)
  rw [key]
  constructor <;> intro h <;> linarith

/-- **The relation of the unit.**  If the weak-copy nook is covered by the guards `bpLEW u` and
`bpLEA u'` and `Γ` by `bpLEA u'`, `bpLEB v` and the guard of the sum, then `u_C + 5/2 ≤ u_W + u_B`: the weak copy
satisfies `u' ≤ u`, and `Γ` gives the relation for `u'`. -/
theorem bpLE_relation {u u' v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hu0' : 1 / 2 ≤ u')
    (hu1' : u' ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2) (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2)
    (hn : ∀ z ∈ convexHull ℝ (intSet bpLEZn), P.Sees (bpLEW u) z ∨ P.Sees (bpLEA u') z)
    (hg : ∀ z ∈ convexHull ℝ (intSet bpLEZg),
      P.Sees (bpLEA u') z ∨ P.Sees (bpLEB v) z ∨ P.Sees (bpLEC w) z) : w + 5 / 2 ≤ u + v := by
  have h1 := (bpLE_nook_iff hP hL hC hS hu0 hu1 hu0' hu1').1 hn
  have h2 := (bpLE_gamma_iff hP hL hC hS (u := u') hu0' hu1' hv0 hv1 hw0 hw1).1 hg
  linarith

end Main

end ArtGallery.BP.Tmpl

end
