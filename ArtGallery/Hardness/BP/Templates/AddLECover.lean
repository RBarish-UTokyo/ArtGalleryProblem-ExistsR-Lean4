/-!
# Boundary-point templates: the addition template `AddBP le` (`u_W + u_B ≥ u_C + 5/2`) — coverage by the canonical guards (T-cover)

**Generated by a program that is not included in this repository** (from a fixed text; the data and
the certificates are in `AddLECoverData.lean`).

As in Section 5 (`Sec5/Templates/*Cover.lean`), for the boundary-point layout.
For an arbitrary simple counter-clockwise
polygon `P` containing the template chain (`ChainAt P bpLEV a`) whose other edges avoid `bpLER`:

* the **template region** `bpLETR` (a finite union of convex integer pieces) contains the filled
  region of the closed template chain `bpLEK` (the chain closed by the **mouth** `bpLEMouth`, the
  segment from the last chain vertex `e_j` back to the first one), `bpLEK_filled_subset`; `bpLEK.filled`
  is a room of `P` with the mouth as door (`bpLE_room`) and `bpLETR ⊆ P.filled` (`bpLETR_subset`);
* **coverage** (`bpLE_cover`): for guard values in `[1/2, 2]` satisfying the constraint `u_C + 5/2 ≤ u_A + u_B`
  (the guard of `A` having the value `u` of `W`, exact weak copy), every point of `bpLETR` is
  seen by one of the canonical guards: `bpLEA u` (`A`), `bpLEB v` (`B`), `bpLEC w` (`C`), `bpLEW u`
  (`W`) and the stationary guard `g`.  The zone `Γ` is covered by the mechanism lemma
  `bpLE_cover_Zg2` (the argument of `bpLE_gamma_iff` on a possibly enlarged zone), the nook by the two-dimensional nook zone `bpLECvZn2` (`CopyPair.nook_covered`);
* **the mouth** (`bpLE_mouth_sees`, `bpLE_sees_beyond_mouth`): the guard of `B` sees the mouth,
  hence every point beyond it in the angle of the mouth that is seen from the whole mouth.
-/

@[expose] public section

namespace ArtGallery.BP.Tmpl

open ArtGallery Set Polygon Vis.Cert Sec5.Tmpl
open ArtGallery.Irrational (HP)

/-- The closed template chain: the chain closed by the mouth `V_last → V₀`. -/
def bpLEK : Polygon := Polygon.mk (bpLEV.map intPoint)

/-- The mouth of the template: the segment from the last chain vertex back to the first. -/
def bpLEMouth : Set Point := ArtGallery.segment (intPoint (cv bpLEV 66)) (intPoint (cv bpLEV 0))

theorem bpLEK_simple : bpLEK.Simple := simple_of_simpleCheck (by decide +kernel)

theorem bpLEK_ccw : bpLEK.InteriorLeft :=
  interiorLeft_of_supportB bpLEK_simple (i := 30) (by decide +kernel)

theorem bpLEV_subList : subList bpLEV 0 66 = bpLEV := by decide +kernel

/-- The stationary guard `g`. -/
theorem bpLE_g_mem : intPoint (cv bpLEV 65) ∈ convexHull ℝ (intSet bpLEGs) :=
  mem_intSet_hull (by decide +kernel)

theorem bpLE_segGuard_affine (A B : IPt) : ∀ s t r : ℝ, segGuard A B (s + r * (t - s)) =
    Geometry.lerp (segGuard A B s) (segGuard A B t) r := by
  intro s t r; simp only [segGuard, Geometry.lerp]; ext <;> simp only <;> ring

/-- The guard bpLEA with a value in `[1, 2]` is on the sub-segment `bpLECvGA`. -/
theorem bpLE_A_mem {u : ℝ} (h0 : (1 : ℝ) ≤ u) (h1 : u ≤ (2 : ℝ)) : bpLEA u ∈ convexHull ℝ (intSet bpLECvGA) :=
  mem_hull_pair_of_affine (segGuard (12609600, 0) (13142400, 0)) (bpLE_segGuard_affine _ _) (lo := (1 : ℝ)) (hi := (2 : ℝ))
    (by norm_num) (by simp only [segGuard, Geometry.lerp, intPoint]; ext <;> norm_num)
    (by simp only [segGuard, Geometry.lerp, intPoint]; ext <;> norm_num) h0 h1

/-- The guard bpLEB with a value in `[1, 2]` is on the sub-segment `bpLECvGB`. -/
theorem bpLE_B_mem {u : ℝ} (h0 : (1 : ℝ) ≤ u) (h1 : u ≤ (2 : ℝ)) : bpLEB u ∈ convexHull ℝ (intSet bpLECvGB) :=
  mem_hull_pair_of_affine (segGuard ((-13142400), 0) ((-12609600), 0)) (bpLE_segGuard_affine _ _) (lo := (1 : ℝ)) (hi := (2 : ℝ))
    (by norm_num) (by simp only [segGuard, Geometry.lerp, intPoint]; ext <;> norm_num)
