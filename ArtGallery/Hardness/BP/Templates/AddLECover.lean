  mem_hull_pair_of_affine (segGuard ((-7814400), (-532800)) ((-7281600), (-532800))) (bpLE_segGuard_affine _ _) (lo := (1 : ℝ)) (hi := (2 : ℝ))
    (by norm_num) (by simp only [segGuard, Geometry.lerp, intPoint]; ext <;> norm_num)
