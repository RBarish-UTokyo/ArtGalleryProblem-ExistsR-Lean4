/-- **Completeness** (restated). -/
theorem bpLEK_sub_TR : bpLEK.filled ⊆ bpLETR := bpLEK_filled_subset

section Main

variable {P : Polygon} {a : ℕ}

/-- A point seen from a point of the region is in the region. -/
theorem bpLE_mem_filled_of_sees {L : List IPt} {g z : Point} (hg : g ∈ convexHull ℝ (intSet L))
    (h : ∀ g ∈ convexHull ℝ (intSet L), P.Sees g z) : z ∈ P.filled :=
  h g hg (by rw [Geometry.segment_comm]; exact Geometry.left_mem_segment _ _)

/-- **The closed template chain is a room of `P` with the mouth as door.** -/
theorem bpLE_room (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpLEV a) :
    P.IsRoom bpLEK.filled bpLEMouth := by
  have h := subList_isRoom hP hL hC (k := 0) (m := 66) (by decide)
    (by rw [bpLEV_subList]; exact bpLEK_simple) (by rw [bpLEV_subList]; exact bpLEK_ccw)
  rw [bpLEV_subList] at h
  exact h

variable (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpLEV a) (hS : SepAt P bpLEV a bpLER)
include hP hL hC hS

/-- The enlarged zone `Γ` lies in the region. -/
theorem bpLECvZg2_sub : convexHull ℝ (intSet bpLECvZg2) ⊆ P.filled :=
  (hull_subset_hull_of_all (by decide +kernel)).trans (bpLECvGA2b_sub hP hL hC hS)

/-- The two-dimensional nook zone lies in the region. -/
theorem bpLECvZn2_sub : convexHull ℝ (intSet bpLECvZn2) ⊆ P.filled :=
  (hull_subset_hull_of_all (by decide +kernel)).trans (bpLECvN2b_sub hP hL hC hS)

/-- **The template region lies in the region of `P`.** -/
theorem bpLETR_subset : bpLETR ⊆ P.filled := by
  rintro z ⟨Q, hQ, hz⟩
  have h1 : (1 / 2 : ℝ) ≤ 1 := by norm_num
  have h2 : (1 : ℝ) ≤ 2 := by norm_num
  rcases bpLECv_dispatch hP hL hC hS Q hQ z hz with h | h | h | h | h | h | h
  · exact bpLE_mem_filled_of_sees (bpLE_A_mem (by norm_num) (by norm_num) (u := 1)) h
  · exact bpLE_mem_filled_of_sees (bpLE_B_mem (by norm_num) (by norm_num) (u := 1)) h
  · exact bpLE_mem_filled_of_sees (bpLE_C_mem (by norm_num) (by norm_num) (u := 1)) h
  · exact bpLE_mem_filled_of_sees (bpLE_I_mem (by norm_num) (by norm_num) (u := 1)) h
  · exact bpLE_mem_filled_of_sees bpLE_g_mem h
  · exact bpLECvZg2_sub hP hL hC hS h
  · exact bpLECvZn2_sub hP hL hC hS h

/-- **The nook zone.**  With the exact weak copy (the guards of `W` and `A` have the same
value), every point of the two-dimensional nook zone is seen by one of the two guards. -/
theorem bpLE_cover_Zn2 {u : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) {z : Point}
    (hz : z ∈ convexHull ℝ (intSet bpLECvZn2)) : P.Sees (bpLEW u) z ∨ P.Sees (bpLEA u) z := by
  have e1 : bpLEW u = bpLECP.p (u - 1 / 2) := by rw [bpLECP_p]; ring_nf
  have e2 : bpLEA u = bpLECP.q (u - 1 / 2) := by rw [bpLECP_q]; ring_nf
  have hw : 0 < bpLECP.w z := by
    have := pos_on_hull (Q := bpLECvZn2) (g := (0, 1, -(bpLEK0).2)) (by decide +kernel) z hz
    simp only [Sec5.Corridor.CopyPair.w, bpLECP, intPoint_snd]
    simp only [Irrational.HP.val] at this; push_cast at this; linarith
  have hLz : bpLECP.L z ≤ 0 := by
    rw [bpLECP_L]
    have := nonneg_on_hull (Q := bpLECvZn2) (g := negHP ((-189250560000), 7002270720000, (-87477967650816000000))) (by decide +kernel) z hz
    rw [negHP_val] at this; linarith
  rcases Sec5.Corridor.CopyPair.nook_covered (t := u - 1 / 2) (t' := u - 1 / 2) bpLECP_hyp (le_refl _) hw
    hLz with h | h
  · left
    have h' : det (bpLEW u) (intPoint (cv bpLEV 62)) z ≤ 0 := by rw [bpLEK0_eq, e1]; exact h
    exact bpLECv_P hP hL hC hS _ (segGuard_mem hu0 hu1) z hz h'
  · right
    have h' : 0 ≤ det (bpLEA u) (intPoint (cv bpLEV 59)) z := by rw [bpLEK1_eq, e2]; exact h
    exact bpLECv_Q hP hL hC hS _ (segGuard_mem hu0 hu1) z hz h'

/-- **The zone `Γ`** (paper Lemma 41, on the enlarged zone): under the constraint, every point of
the enlarged zone is seen by one of the three guards of the mechanism. -/
theorem bpLE_cover_Zg2 {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) (hc : w + 5 / 2 ≤ u + v) {z : Point} (hz : z ∈ convexHull ℝ (intSet bpLECvZg2)) :
    P.Sees (bpLEA u) z ∨ P.Sees (bpLEB v) z ∨ P.Sees (bpLEC w) z := by
  by_contra hcon
  push Not at hcon
  obtain ⟨h1, h2, h3⟩ := hcon
  have dA : 0 < det (bpLEA u) (intPoint bpLEEi) z := by
    by_contra h; push Not at h
    exact h1 (bpLECv_GA hP hL hC hS _ (segGuard_mem hu0 hu1) z hz (by rw [bpLEEi_eq]; exact h))
  have dB : 0 < det (bpLEB v) (intPoint bpLEEj) z := by
    by_contra h; push Not at h
    exact h2 (bpLECv_GB hP hL hC hS _ (segGuard_mem hv0 hv1) z hz (by rw [bpLEEj_eq]; exact h))
  have dC : det (bpLEC w) (intPoint bpLEEl) z < 0 := by
    by_contra h; push Not at h
    exact h3 (bpLECv_GC hP hL hC hS _ (segGuard_mem hw0 hw1) z hz (by rw [bpLEEl_eq]; exact h))
  have hz2 := pos_on_hull (Q := bpLECvZg2) (g := (0, 1, -3729600)) (by decide +kernel) z hz
  simp only [Irrational.HP.val] at hz2
  push_cast at hz2
  have hid := bpLE_gamma_id u v w z
  rw [bpLE_gamma_x] at hid
  have : (z.2 - 3729600) * (355200 * (w + 5 / 2 - u - v)) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (by linarith) (by nlinarith)
  linarith

/-- **T-cover for the addition template `AddBP le` (`u_W + u_B ≥ u_C + 5/2`).**  For guard values in `[1/2, 2]` with `u_C + 5/2 ≤ u_A + u_B`, every point of the
template region is seen by one of the canonical guards. -/
theorem bpLE_cover {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) (hc : w + 5 / 2 ≤ u + v) :
    ∀ z ∈ bpLETR, P.Sees (bpLEA u) z ∨ P.Sees (bpLEB v) z ∨ P.Sees (bpLEC w) z ∨ P.Sees (bpLEW u) z ∨
      P.Sees (intPoint (cv bpLEV 65)) z := by
  rintro z ⟨Q, hQ, hz⟩
  have hu0' : 1 ≤ u := by linarith
  have hv0' : 1 ≤ v := by linarith
  have hw1' : w ≤ 3 / 2 := by linarith
  rcases bpLECv_dispatch hP hL hC hS Q hQ z hz with h | h | h | h | h | h | h
  · exact Or.inl (h _ (bpLE_A_mem hu0' hu1))
  · exact Or.inr (Or.inl (h _ (bpLE_B_mem hv0' hv1)))
  · exact Or.inr (Or.inr (Or.inl (h _ (bpLE_C_mem hw0 hw1'))))
  · exact Or.inr (Or.inr (Or.inr (Or.inl (h _ (bpLE_I_mem hu0' hu1)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (h _ bpLE_g_mem))))
  · rcases bpLE_cover_Zg2 hP hL hC hS hu0 hu1 hv0 hv1 hw0 hw1 hc h with h' | h' | h'
    · exact Or.inl h'
    · exact Or.inr (Or.inl h')
    · exact Or.inr (Or.inr (Or.inl h'))
  · rcases bpLE_cover_Zn2 hP hL hC hS hu0 hu1 h with h' | h'
    · exact Or.inr (Or.inr (Or.inr (Or.inl h')))
    · exact Or.inl h'

/-- **T-cover, region form**: every point of the closed template chain is seen. -/
theorem bpLE_cover_K {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) (hc : w + 5 / 2 ≤ u + v) :
    ∀ z ∈ bpLEK.filled, P.Sees (bpLEA u) z ∨ P.Sees (bpLEB v) z ∨ P.Sees (bpLEC w) z ∨
      P.Sees (bpLEW u) z ∨ P.Sees (intPoint (cv bpLEV 65)) z :=
  fun z hz => bpLE_cover hP hL hC hS hu0 hu1 hv0 hv1 hw0 hw1 hc z (bpLEK_filled_subset hz)

/-- **The mouth is seen by the guard of `B`** (any value). -/
theorem bpLE_mouth_sees {v : ℝ} (hv0 : 1 ≤ v) (hv1 : v ≤ 2) :
    ∀ m ∈ bpLEMouth, P.Sees (bpLEB v) m := fun m hm =>
  bpLECvm_sees hP hL hC hS _ (bpLE_B_mem hv0 hv1) m
    (segment_subset_hull (by decide +kernel) (by decide +kernel) hm)

/-- **Seeing beyond the mouth**: a point `z` strictly beyond the mouth line, inside the angle at
the guard spanned by the two mouth ends, and seen from every point of the mouth, is seen by the
guard of `B`. -/
theorem bpLE_sees_beyond_mouth {v : ℝ} (hv0 : 1 ≤ v) (hv1 : v ≤ 2) {z : Point}
    (hz : det (intPoint (cv bpLEV 66)) (intPoint (cv bpLEV 0)) z < 0)
    (h0 : det (bpLEB v) z (intPoint (cv bpLEV 66)) ≤ 0) (h1 : 0 ≤ det (bpLEB v) z (intPoint (cv bpLEV 0)))
    (hm : ∀ m ∈ bpLEMouth, P.Sees m z) : P.Sees (bpLEB v) z := by
  have hp : 0 < det (intPoint (cv bpLEV 66)) (intPoint (cv bpLEV 0)) (bpLEB v) := by
    rw [← lineHP_val]; exact pos_on_hull (by decide +kernel) _ (bpLE_B_mem hv0 hv1)
  obtain ⟨m, hmM, hmz⟩ := exists_mem_segment_inter (mul_neg_of_pos_of_neg hp hz) h0 h1
  exact sees_of_mem_segment hmz (bpLE_mouth_sees hP hL hC hS hv0 hv1 m hmM) (hm m hmM)

