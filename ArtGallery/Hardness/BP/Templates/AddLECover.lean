/-- The guard bpLEC with a value in `[1/2, 3/2]` is on the sub-segment `bpLECvGC`. -/
theorem bpLE_C_mem {u : ℝ} (h0 : (1 / 2 : ℝ) ≤ u) (h1 : u ≤ (3 / 2 : ℝ)) : bpLEC u ∈ convexHull ℝ (intSet bpLECvGC) :=
  mem_hull_pair_of_affine (segGuard (177600, (-3729600)) (710400, (-3729600))) (bpLE_segGuard_affine _ _) (lo := (1 / 2 : ℝ)) (hi := (3 / 2 : ℝ))
    (by norm_num) (by simp only [segGuard, Geometry.lerp, intPoint]; ext <;> norm_num)
