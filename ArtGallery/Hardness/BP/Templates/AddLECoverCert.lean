theorem bpLECv_dispatch (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpLEV a) (hS : SepAt P bpLEV a bpLER) :
    ∀ Q ∈ bpLECvPieces, ∀ z ∈ convexHull ℝ (intSet Q),
