  · exact Or.inr (Or.inr (Or.inl (fun g hg => bpInvCvgF12_sees hP hL hC hS g hg z hz)))
  · exact Or.inr (Or.inr (Or.inl (fun g hg => bpInvCvgF13_sees hP hL hC hS g hg z hz)))
