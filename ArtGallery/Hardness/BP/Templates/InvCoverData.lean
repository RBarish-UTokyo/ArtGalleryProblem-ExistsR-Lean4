theorem bpInvCv_np (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpInvV a) (hS : SepAt P bpInvV a bpInvR) :
    ∀ g ∈ convexHull ℝ (intSet bpInvRi), ∀ z ∈ convexHull ℝ (intSet bpInvCvZn2),
