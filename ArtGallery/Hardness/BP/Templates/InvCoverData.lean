/-- **Dispatch**: every point of a cover piece is seen by the guard family of its piece, or lies
in one of the two zones. -/
theorem bpInvCv_dispatch (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpInvV a) (hS : SepAt P bpInvV a bpInvR) :
    ∀ Q ∈ bpInvCvPieces, ∀ z ∈ convexHull ℝ (intSet Q),
      (∀ g ∈ convexHull ℝ (intSet bpInvRi), P.Sees g z) ∨ (∀ g ∈ convexHull ℝ (intSet bpInvRj), P.Sees g z) ∨
      (∀ g ∈ convexHull ℝ (intSet bpInvGs), P.Sees g z) ∨ z ∈ convexHull ℝ (intSet bpInvZu) ∨
      z ∈ convexHull ℝ (intSet bpInvCvZn2) := by
  intro Q hQ z hz
  simp only [bpInvCvPieces, List.mem_cons, List.not_mem_nil, or_false] at hQ
  rcases hQ with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact Or.inl (fun g hg => bpInvCvpBox_sees hP hL hC hS g hg z hz)
  · exact Or.inl (fun g hg => bpInvCvpS1_sees hP hL hC hS g hg z hz)
  · exact Or.inl (fun g hg => bpInvCvpS2_sees hP hL hC hS g hg z hz)
  · exact Or.inl (fun g hg => bpInvCvpRoom_sees hP hL hC hS g hg z hz)
  · exact Or.inl (fun g hg => bpInvCvpUp_sees hP hL hC hS g hg z hz)
  · exact Or.inr (Or.inl (fun g hg => bpInvCvNq_sees hP hL hC hS g hg z hz))
  · exact Or.inl (fun g hg => bpInvCvNp_sees hP hL hC hS g hg z hz)
  · exact Or.inr (Or.inl (fun g hg => bpInvCvqBox_sees hP hL hC hS g hg z hz))
  · exact Or.inr (Or.inl (fun g hg => bpInvCvqS1_sees hP hL hC hS g hg z hz))
  · exact Or.inr (Or.inl (fun g hg => bpInvCvqS2_sees hP hL hC hS g hg z hz))
  · exact Or.inr (Or.inl (fun g hg => bpInvCvqRoom_sees hP hL hC hS g hg z hz))
  · exact Or.inr (Or.inl (fun g hg => bpInvCvqUp_sees hP hL hC hS g hg z hz))
  · exact Or.inr (Or.inl (fun g hg => bpInvCvqFl_sees hP hL hC hS g hg z hz))
