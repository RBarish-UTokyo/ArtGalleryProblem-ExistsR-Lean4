/-- **Pinning on the boundary**: a point of `∂P` seeing both spike tips of the bay of `B`
lies on `B`. -/
theorem bpOR_spot_B {x : Point} (hx : x ∈ P.boundary) (h1 : P.Sees x (tpt bpORV 3))
    (h2 : P.Sees x (tpt bpORV 8)) : x ∈ convexHull ℝ (intSet bpORSegB) := by
  have hz : ∀ c ∈ spikeHPs bpORV 3 5 ++ spikeHPs bpORV 8 5, 0 ≤ c.val x := by
    intro c hc
    rcases List.mem_append.1 hc with hc | hc
    exacts [bpOR_hp_3 hP hL hC h1 c hc, bpOR_hp_8 hP hL hC h2 c hc]
  obtain ⟨j, hj, -, hxj⟩ := bd_on_targets hP hC hS (rc := bpORSpotBRC)
    (tg := [5]) (ec := bpORSpotBEC) (by decide +kernel) (by decide +kernel) hx hz
