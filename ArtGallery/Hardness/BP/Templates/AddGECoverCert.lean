/-- **Dispatch**: every point of a cover piece is seen by the guard family of its piece, or lies
in one of the two zones. -/
theorem bpGECv_dispatch (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpGEV a) (hS : SepAt P bpGEV a bpGER) :
    ∀ Q ∈ bpGECvPieces, ∀ z ∈ convexHull ℝ (intSet Q),
      (∀ g ∈ convexHull ℝ (intSet bpGESegA), P.Sees g z) ∨ (∀ g ∈ convexHull ℝ (intSet bpGESegB), P.Sees g z) ∨
      (∀ g ∈ convexHull ℝ (intSet bpGESegC), P.Sees g z) ∨ (∀ g ∈ convexHull ℝ (intSet bpGESegW), P.Sees g z) ∨
      (∀ g ∈ convexHull ℝ (intSet bpGEGs), P.Sees g z) ∨ z ∈ convexHull ℝ (intSet bpGECvZg2) ∨
