/-- `Γ`, guard on `A`: it sees a point of `Γ` iff the point is on or above the line through the guard and `e_i`. -/
theorem bpOR_vis_A (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpORV a) (hS : SepAt P bpORV a bpORR) :
    ∀ g ∈ convexHull ℝ (intSet bpORSegA), ∀ z ∈ convexHull ℝ (intSet bpORZg),
      (P.Sees g z ↔ det g (intPoint (cv bpORV 41)) z ≤ 0) := by
  intro g hg z hz
  constructor
  · intro hs
    by_contra hc
    push Not at hc
    have hcorner : halfCorner bpORV 40 false = cv bpORV 41 := rfl
    have hh := not_sees_of_chainHalf hP hC (j := 40) (rev := false) (P₁ := bpORZg) (Q₁ := bpORSegA)
      (by decide +kernel)
    rw [hcorner] at hh
    exact hh z hz g hg (by rw [← Geometry.det_cyclic]; exact hc) (Polygon.sees_comm.1 hs)
  · intro hr
    have hgate := sees_of_gate (P := P) (convex_convexHull ℝ _) (convex_convexHull ℝ _)
      (bpORGA2_sub hP hL hC hS) (bpORGA1_sub hP hL hC hS) (g₀ := cv bpORV 41) (g₁ := bpORG1A) (P₁ := bpORZg) (Q₁ := bpORSegA)
      (hull_subset_hull_of_all (by decide +kernel)) (hull_subset_hull_of_all (by decide +kernel))
      (segment_subset_hull (by decide +kernel) (by decide +kernel))
      (segment_subset_hull (by decide +kernel) (by decide +kernel)) (by decide +kernel)
    exact Polygon.sees_comm.1 (hgate z hz g hg (by rw [← Geometry.det_cyclic]; exact hr))

