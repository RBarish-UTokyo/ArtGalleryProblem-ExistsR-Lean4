theorem bpLECv_anchors : bpLECvAnchors.all (anchorB bpLEV) = true := by decide +kernel

theorem bpLECv_bsp : bspB bpLEV bpLECvPieces bpLECvAnchors bpLECvBox bpLECvTree = true := by decide +kernel

theorem bpLECv_box : (bpLECvBox.all fun c => nondegHP c && bpLEV.all fun v => inonneg (ivalHP c v)) = true := by
  decide +kernel

theorem bpLECv_bd : bdCoverB bpLEV bpLECvPieces bpLECvBd = true := by decide +kernel

/-- **Completeness**: the closed template chain is covered by the pieces. -/
theorem bpLEK_filled_subset : (Polygon.mk (bpLEV.map intPoint)).filled ⊆ bpLETR :=
  filled_subset_cover bpLECv_fan bpLECv_anchors bpLECv_bsp bpLECv_box bpLECv_bd

