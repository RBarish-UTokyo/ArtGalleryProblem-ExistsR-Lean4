/-- **Dispatch**: every point of a cover piece is seen by the guard family of its piece, or lies
in one of the two zones. -/
theorem bpORCv_dispatch (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpORV a) (hS : SepAt P bpORV a bpORR) :
    ∀ Q ∈ bpORCvPieces, ∀ z ∈ convexHull ℝ (intSet Q),
      (∀ g ∈ convexHull ℝ (intSet bpORSegA), P.Sees g z) ∨ (∀ g ∈ convexHull ℝ (intSet bpORSegB), P.Sees g z) ∨
      (∀ g ∈ convexHull ℝ (intSet bpORPs), P.Sees g z) ∨ (∀ g ∈ convexHull ℝ (intSet bpORSegW), P.Sees g z) ∨
      (∀ g ∈ convexHull ℝ (intSet bpORGs), P.Sees g z) ∨ z ∈ convexHull ℝ (intSet bpORCvZg2) ∨
      z ∈ convexHull ℝ (intSet bpORCvZn2) := by
  intro Q hQ z hz
  simp only [bpORCvPieces, List.mem_cons, List.not_mem_nil, or_false] at hQ
  rcases hQ with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact Or.inr (Or.inl (fun g hg => bpORCva0_sees hP hL hC hS g hg z hz))
  · exact Or.inr (Or.inl (fun g hg => bpORCva1_sees hP hL hC hS g hg z hz))
  · exact Or.inr (Or.inr (Or.inr (Or.inl (fun g hg => bpORCva2_sees hP hL hC hS g hg z hz))))
  · exact Or.inr (Or.inr (Or.inr (Or.inl (fun g hg => bpORCva3_sees hP hL hC hS g hg z hz))))
  · exact Or.inr (Or.inr (Or.inl (fun g hg => bpORCva4_sees hP hL hC hS g hg z hz)))
  · exact Or.inr (Or.inr (Or.inl (fun g hg => bpORCva5_sees hP hL hC hS g hg z hz)))
  · exact Or.inr (Or.inr (Or.inl (fun g hg => bpORCva6_sees hP hL hC hS g hg z hz)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (fun g hg => bpORCva8_sees hP hL hC hS g hg z hz)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (fun g hg => bpORCva9_sees hP hL hC hS g hg z hz)))))
