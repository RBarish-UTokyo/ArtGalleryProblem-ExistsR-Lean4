module

public import ArtGallery.Hardness.BP.Templates.AddGECert
public import ArtGallery.Hardness.Sec5.Templates.AddCommon

/-!
# Boundary-point templates: the addition template `AddBP ge` (`u_W + u_B ≥ u_C`) — template facts

**Generated by a program that is not included in this repository** (the data and certificates are
in `AddGEData.lean`, `AddGECert.lean`).

Integer template coordinates (the template point `T` of the boundary-point template
is `bpGED · T`).  All statements are about an arbitrary simple counter-clockwise polygon `P`
containing the template chain (`ChainAt P bpGEV a`) whose other edges avoid `bpGER`
(`SepAt P bpGEV a bpGER`); `bpGEPT` (the chain closed by the fixed stub) is such a polygon.
Guards (values in `[1/2, 2]`, all segments right-oriented, `segGuard`, all on the floors of
bays): `bpGEA u` on `A` (the weak copy of `W`), `bpGEB v` on `B` (the direct summand),
`bpGEC w` on `C` (the sum), `bpGEW u` on `W`.

* (T-simple) `bpGEPT_simple`, `bpGEPT_ccw`, `bpGEPT_chain`, `bpGEPT_sep`;
* (T-mech) `bpGE_gamma_iff`: `Γ ⊆ V(A) ∪ V(B) ∪ V(C)` iff `u_C ≤ u_A + u_B` (projection identity
  `bpGE_gamma_id`, paper Lemma 41); `bpGE_nook_iff`: the weak-copy nook of `(W, A)` is covered iff
  `u_A ≤ u_W`.  With `u_A ≤ u_W` (the nook) and `Γ` covered, the relation of the unit holds for
  `u_W` (design: `docs/boundary_point/design.md`, §3.2);
* the counting facts for guards on the boundary are in `CountAddGE.lean`.
-/

@[expose] public section

namespace ArtGallery.BP.Tmpl

open ArtGallery Set Polygon Vis.Cert Sec5.Tmpl
open ArtGallery.Irrational (HP)

/-! ### The template polygon -/

/-- The template polygon `P_T`: the chain closed by the stub. -/
def bpGEPT : Polygon := ⟨bpGEVT.map intPoint⟩

theorem bpGEPT_simple : bpGEPT.Simple := simple_of_simpleCheck (by decide +kernel)

theorem bpGEPT_ccw : bpGEPT.InteriorLeft :=
  interiorLeft_of_lowB bpGEPT_simple (i := 30) (by decide +kernel)

theorem bpGEPT_chain : ChainAt bpGEPT bpGEV 0 := chainAt_append _ _

theorem bpGEPT_sep : SepAt bpGEPT bpGEV 0 bpGER := sepAt_append (by decide) (by decide +kernel)

/-! ### Guards and the projection identity -/

/-- The guard on `A` with value `u`. -/
noncomputable def bpGEA (u : ℝ) : Point := segGuard (10579200, 0) (10996800, 0) u

/-- The guard on `B` with value `v`. -/
noncomputable def bpGEB (v : ℝ) : Point := segGuard ((-10996800), 0) ((-10579200), 0) v

/-- The guard on `C` with value `w`. -/
noncomputable def bpGEC (w : ℝ) : Point := segGuard ((-556800), (-2923200)) ((-139200), (-2923200)) w

/-- The guard on `W` with value `u`. -/
noncomputable def bpGEW (u : ℝ) : Point := segGuard ((-6124800), (-1113600)) ((-5707200), (-1113600)) u

theorem bpGED_real : (bpGED : ℝ) = 278400 := by norm_num [bpGED]

/-- **The projection identity** (paper Lemma 41). -/
theorem bpGE_gamma_id (u v w : ℝ) (z : Point) :
    det (bpGEA u) (intPoint bpGEEi) z + det (bpGEB v) (intPoint bpGEEj) z -
      det (bpGEC w) (intPoint bpGEEl) z =
      (z.2 - 2923200) * ((bpGEC w).1 - (bpGEA u).1 - (bpGEB v).1) := by
  simp only [bpGEA, bpGEB, bpGEC, segGuard, Geometry.lerp, det, intPoint, bpGEEi, bpGEEj, bpGEEl]
  push_cast; ring

theorem bpGE_gamma_x (u v w : ℝ) :
    (bpGEC w).1 - (bpGEA u).1 - (bpGEB v).1 = 278400 * (w - u - v) := by
  simp only [bpGEA, bpGEB, bpGEC, segGuard, Geometry.lerp, intPoint]
  push_cast; ring

theorem bpGEA_shift (u δ : ℝ) : bpGEA (u + δ) = ((bpGEA u).1 + 278400 * δ, (bpGEA u).2) := by
  simp only [bpGEA, segGuard, Geometry.lerp, intPoint]; push_cast; ext <;> simp only <;> ring

theorem bpGEB_shift (v δ : ℝ) : bpGEB (v + δ) = ((bpGEB v).1 + 278400 * δ, (bpGEB v).2) := by
  simp only [bpGEB, segGuard, Geometry.lerp, intPoint]; push_cast; ext <;> simp only <;> ring

theorem bpGEZg_h : ∀ z ∈ convexHull ℝ (intSet bpGEZg), 2923200 < z.2 := by
  intro z hz
  have := pos_on_hull (Q := bpGEZg) (g := (0, 1, -2923200)) (by decide +kernel) z hz
  simp only [Irrational.HP.val] at this; push_cast at this; linarith

/-! ### The crossing points `γ(u, v)` -/

/-- Numerator of the crossing parameter. -/
noncomputable def bpGENum (u v : ℝ) : ℝ := det (bpGEB v) (intPoint bpGEEj) (bpGEA u)

/-- Denominator of the crossing parameter (positive). -/
noncomputable def bpGEDen (u v : ℝ) : ℝ :=
  det (bpGEB v) (intPoint bpGEEj) (intPoint bpGEEi) - bpGENum u v

/-- The crossing point `γ(u, v)` of the lines `(bpGEA u) e_i` and `(bpGEB v) e_j`. -/
noncomputable def bpGEX (u v : ℝ) : Point :=
  Geometry.lerp (bpGEA u) (intPoint bpGEEi) (-bpGENum u v / bpGEDen u v)

/-- The edge function of the zone edge `Q₁ Q₂` at `γ(u, v)`, times the denominator. -/
noncomputable def bpGEBil (Q₁ Q₂ : IPt) (u v : ℝ) : ℝ :=
  det (bpGEB v) (intPoint bpGEEj) (intPoint bpGEEi) * det (intPoint Q₁) (intPoint Q₂) (bpGEA u) -
    bpGENum u v * det (intPoint Q₁) (intPoint Q₂) (intPoint bpGEEi)

theorem bpGEBil_hf (Q₁ Q₂ : IPt) : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * bpGEBil Q₁ Q₂ x y =
    (5 / 2 - x) * (5 / 2 - y) * bpGEBil Q₁ Q₂ (1 / 2) (1 / 2) +
      (x - 1 / 2) * (5 / 2 - y) * bpGEBil Q₁ Q₂ (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * bpGEBil Q₁ Q₂ (1 / 2) (5 / 2) +
      (x - 1 / 2) * (y - 1 / 2) * bpGEBil Q₁ Q₂ (5 / 2) (5 / 2) := by
  intro x y
  simp only [bpGEBil, bpGENum, det, bpGEB, bpGEA, segGuard, Geometry.lerp, intPoint]
  ring

theorem bpGEDen_hf : ∀ x y : ℝ, (5 / 2 - 1 / 2) ^ 2 * bpGEDen x y =
    (5 / 2 - x) * (5 / 2 - y) * bpGEDen (1 / 2) (1 / 2) +
      (x - 1 / 2) * (5 / 2 - y) * bpGEDen (5 / 2) (1 / 2) +
      (5 / 2 - x) * (y - 1 / 2) * bpGEDen (1 / 2) (5 / 2) +
      (x - 1 / 2) * (y - 1 / 2) * bpGEDen (5 / 2) (5 / 2) := by
  intro x y
  simp only [bpGEDen, bpGENum, det, bpGEB, bpGEA, segGuard, Geometry.lerp, intPoint]
  ring

/-- Unfold a corner value. -/
macro "bpGE_corner" : tactic =>
  `(tactic| (simp only [bpGEBil, bpGEDen, bpGENum, det, bpGEB, bpGEA, segGuard, Geometry.lerp,
    intPoint, bpGEEi, bpGEEj, bpGEZg0, bpGEZg1, bpGEZg2, bpGEZg3]; norm_num))

theorem bpGEDen_pos {x y : ℝ} (hx0 : 1 / 2 ≤ x) (hx1 : x ≤ 5 / 2) (hy0 : 1 / 2 ≤ y)
    (hy1 : y ≤ 5 / 2) : 0 < bpGEDen x y :=
  bilin_pos_box (by norm_num) bpGEDen bpGEDen_hf (by bpGE_corner) (by bpGE_corner) (by bpGE_corner)
    (by bpGE_corner) hx0 hx1 hy0 hy1

theorem bpGEX_mem {x y : ℝ} (hx0 : 1 / 2 ≤ x) (hx1 : x ≤ 5 / 2) (hy0 : 1 / 2 ≤ y)
    (hy1 : y ≤ 5 / 2) : bpGEX x y ∈ convexHull ℝ (intSet bpGEZg) := by
  have hd := bpGEDen_pos hx0 hx1 hy0 hy1
  have edge : ∀ Q₁ Q₂ : IPt, 0 ≤ bpGEBil Q₁ Q₂ (1 / 2) (1 / 2) → 0 ≤ bpGEBil Q₁ Q₂ (5 / 2) (1 / 2) →
      0 ≤ bpGEBil Q₁ Q₂ (1 / 2) (5 / 2) → 0 ≤ bpGEBil Q₁ Q₂ (5 / 2) (5 / 2) →
      0 ≤ det (intPoint Q₁) (intPoint Q₂) (bpGEX x y) := by
    intro Q₁ Q₂ h1 h2 h3 h4
    have := bilin_nonneg_box (by norm_num) (bpGEBil Q₁ Q₂) (bpGEBil_hf Q₁ Q₂) h1 h2 h3 h4 hx0 hx1
      hy0 hy1
    have e : bpGEDen x y * det (intPoint Q₁) (intPoint Q₂) (bpGEX x y) = bpGEBil Q₁ Q₂ x y := by
      rw [bpGEX, Geometry.det_lerp, bpGEBil]
      have e' : det (bpGEB y) (intPoint bpGEEj) (intPoint bpGEEi) = bpGEDen x y + bpGENum x y := by
        rw [bpGEDen]; ring
      rw [e']
      field_simp
      ring
    rw [← e] at this
    exact nonneg_of_mul_nonneg_right (by linarith) hd
  rw [bpGEZg_eq]
  refine mem_hull_quad (A := bpGEZg0) (B := bpGEZg1) (C := bpGEZg2) (D := bpGEZg3)
    (by simp) (by simp) (by simp) (by simp) (by decide +kernel) (by decide +kernel)
    (edge _ _ (by bpGE_corner) (by bpGE_corner) (by bpGE_corner) (by bpGE_corner))
    (edge _ _ (by bpGE_corner) (by bpGE_corner) (by bpGE_corner) (by bpGE_corner))
    (edge _ _ (by bpGE_corner) (by bpGE_corner) (by bpGE_corner) (by bpGE_corner))
    (edge _ _ (by bpGE_corner) (by bpGE_corner) (by bpGE_corner) (by bpGE_corner))

theorem bpGEX_onA (x y : ℝ) : det (bpGEA x) (intPoint bpGEEi) (bpGEX x y) = 0 :=
  Geometry.det_lerp_self _ _ _

theorem bpGEX_onB {x y : ℝ} (hd : bpGEDen x y ≠ 0) :
    det (bpGEB y) (intPoint bpGEEj) (bpGEX x y) = 0 := by
  rw [bpGEX, Geometry.det_lerp]
  have e : det (bpGEB y) (intPoint bpGEEj) (bpGEA x) = bpGENum x y := rfl
  rw [e]
  have e2 : det (bpGEB y) (intPoint bpGEEj) (intPoint bpGEEi) = bpGENum x y + bpGEDen x y := by
    rw [bpGEDen]; ring
  rw [e2]
  field_simp
  ring

/-! ### The weak-copy nook: the copy pair `(W, A)` -/

/-- The copy pair of the weak-copy nook (shadow corners `k0`, `k1`; scale `D`). -/
noncomputable def bpGECP : Sec5.Corridor.CopyPair ℝ :=
  ⟨intPoint bpGEK0, intPoint bpGEK1, intPoint ((-6124800), (-1113600)), intPoint (10579200, 0), 278400, 278400⟩

theorem bpGECP_hyp : bpGECP.Hyp :=
  ⟨by simp [bpGECP, intPoint, bpGEK0, bpGEK1], by simp [bpGECP], by simp [bpGECP]⟩

theorem bpGECP_adm : bpGECP.Adm (3 / 2) := by
  refine ⟨by norm_num, ?_, ?_, ?_, ?_, ?_⟩ <;>
    simp only [bpGECP, Sec5.Corridor.CopyPair.p, Sec5.Corridor.CopyPair.q, intPoint, bpGEK0, bpGEK1] <;> norm_num

theorem bpGECP_p (t : ℝ) : bpGECP.p t = bpGEW (t + 1 / 2) := by
  simp only [bpGECP, Sec5.Corridor.CopyPair.p, bpGEW, segGuard, Geometry.lerp, intPoint]; push_cast
  ext <;> simp only <;> ring

theorem bpGECP_q (t : ℝ) : bpGECP.q t = bpGEA (t + 1 / 2) := by
  simp only [bpGECP, Sec5.Corridor.CopyPair.q, bpGEA, segGuard, Geometry.lerp, intPoint]; push_cast
  ext <;> simp only <;> ring

theorem bpGECP_L (z : Point) : bpGECP.L z = Irrational.HP.val (((-310026240000), 4495380480000, (-43846143049728000000))) z := by
  simp only [bpGECP, Sec5.Corridor.CopyPair.L, Sec5.Corridor.det2, intPoint, bpGEK0, bpGEK1, Irrational.HP.val]
  push_cast; ring

theorem bpGECP_X00 : bpGECP.X 0 0 = Geometry.lerp (intPoint bpGEZna) (intPoint bpGEZnb) ((23 / 31 : ℝ)) := by
  simp only [Sec5.Corridor.CopyPair.X, Sec5.Corridor.lineInter, Sec5.Corridor.lineDen, Sec5.Corridor.CopyPair.p,
    Sec5.Corridor.CopyPair.q, bpGECP, Geometry.lerp, intPoint, bpGEK0, bpGEK1, bpGEZna, bpGEZnb]
  norm_num

theorem bpGECP_Xll : bpGECP.X (3 / 2) (3 / 2) =
    Geometry.lerp (intPoint bpGEZna) (intPoint bpGEZnb) ((251 / 1057 : ℝ)) := by
  simp only [Sec5.Corridor.CopyPair.X, Sec5.Corridor.lineInter, Sec5.Corridor.lineDen, Sec5.Corridor.CopyPair.p,
    Sec5.Corridor.CopyPair.q, bpGECP, Geometry.lerp, intPoint, bpGEK0, bpGEK1, bpGEZna, bpGEZnb]
  norm_num

theorem bpGECP_Xmem {v : ℝ} (h0 : 0 ≤ v) (h1 : v ≤ 3 / 2) :
    bpGECP.X v v ∈ convexHull ℝ (intSet bpGEZn) := by
  obtain ⟨α, hα0, hα1, e⟩ := Sec5.Corridor.CopyPair.X_diag_mem bpGECP_hyp bpGECP_adm (by norm_num) h0 h1
  rw [bpGECP_X00, bpGECP_Xll] at e
  have : bpGECP.X v v = Geometry.lerp (intPoint bpGEZna) (intPoint bpGEZnb)
      ((23 / 31 : ℝ) + α * ((251 / 1057 : ℝ) - (23 / 31 : ℝ))) := by
    rw [e]; simp only [Geometry.lerp]; ext <;> simp only <;> ring
  rw [this, bpGEZn_eq]
  exact mem_hull_pair (by nlinarith) (by nlinarith)

/-! ### Main statements -/

section Main

variable {P : Polygon} {a : ℕ}
variable (hP : P.Simple) (hL : P.InteriorLeft) (hC : ChainAt P bpGEV a) (hS : SepAt P bpGEV a bpGER)
include hP hL hC hS

/-- **`Γ` of the ge template (paper Lemma 41).**  For values in `[1/2, 2]`, the zone `Γ`
(containing all crossing points of the lines through the guards of `A`, `B` and the corners
`e_i`, `e_j`) is seen by the three guards iff `u_C ≤ u_A + u_B`. -/
theorem bpGE_gamma_iff {u v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2)
    (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2) :
    (∀ z ∈ convexHull ℝ (intSet bpGEZg),
      P.Sees (bpGEA u) z ∨ P.Sees (bpGEB v) z ∨ P.Sees (bpGEC w) z) ↔ w ≤ u + v := by
  have hA : ∀ z ∈ convexHull ℝ (intSet bpGEZg), P.Sees (bpGEA u) z ↔ det (bpGEA u) (intPoint bpGEEi) z ≤ 0 := by
    intro z hz; rw [← bpGEEi_eq]; exact bpGE_vis_A hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
  have hB : ∀ z ∈ convexHull ℝ (intSet bpGEZg), P.Sees (bpGEB v) z ↔ det (bpGEB v) (intPoint bpGEEj) z ≤ 0 := by
    intro z hz; rw [← bpGEEj_eq]; exact bpGE_vis_B hP hL hC hS _ (segGuard_mem hv0 hv1) z hz
  have hCC : ∀ z ∈ convexHull ℝ (intSet bpGEZg), P.Sees (bpGEC w) z ↔ 0 ≤ det (bpGEC w) (intPoint bpGEEl) z := by
    intro z hz; rw [← bpGEEl_eq]; exact bpGE_vis_C hP hL hC hS _ (segGuard_mem hw0 hw1) z hz
  have hx := bpGE_gamma_x u v w
  have hD : (0 : ℝ) < 278400 := by norm_num
  constructor
  · intro hall
    by_contra hneg
    push Not at hneg
    set δ := (w - u - v) / 7 with hδ
    have hδ0 : 0 < δ := by rw [hδ]; linarith
    have hδ1 : δ ≤ 1 / 2 := by rw [hδ]; linarith
    have hd := bpGEDen_pos (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hz := bpGEX_mem (x := u + δ) (y := v + δ) (by linarith) (by linarith) (by linarith)
      (by linarith)
    have hzA := bpGEX_onA (u + δ) (v + δ)
    have hzB := bpGEX_onB hd.ne'
    rw [bpGEA_shift] at hzA
    rw [bpGEB_shift] at hzB
    obtain ⟨h1, h2, h3⟩ := gamma_gap hA hB hCC (bpGE_gamma_id u v w) hz (bpGEZg_h _ hz)
      (by norm_num [bpGEEi, intPoint]) (by norm_num [bpGEEj, intPoint])
      (δ := 278400 * δ) (by positivity) (by rw [hx]; nlinarith) hzA hzB
    rcases hall _ hz with h | h | h
    exacts [h1 h, h2 h, h3 h]
  · intro hle
    have hneg : w - u - v ≤ 0 := by linarith
    exact gamma_cover hA hB hCC (bpGE_gamma_id u v w) bpGEZg_h
      (by nlinarith [mul_nonpos_of_nonneg_of_nonpos hD.le hneg])

/-- **The weak-copy nook of the ge template.**  For values `u` on `W` and `u'` on `A`
in `[1/2, 2]`, the nook zone is seen by the two guards iff `u' ≤ u`. -/
theorem bpGE_nook_iff {u u' : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hu0' : 1 / 2 ≤ u') (hu1' : u' ≤ 2) :
    (∀ z ∈ convexHull ℝ (intSet bpGEZn), P.Sees (bpGEW u) z ∨ P.Sees (bpGEA u') z) ↔ u' ≤ u := by
  have e1 : bpGEW u = bpGECP.p (u - 1 / 2) := by rw [bpGECP_p]; ring_nf
  have e2 : bpGEA u' = bpGECP.q (u' - 1 / 2) := by rw [bpGECP_q]; ring_nf
  rw [e1, e2]
  have key := copyNook_iff (P := P) bpGECP bpGECP_hyp bpGECP_adm (Z := convexHull ℝ (intSet bpGEZn))
    (t := u - 1 / 2) (t' := u' - 1 / 2) (by linarith) (by linarith)
    (fun z hz => by
      rw [← e1]
      have := bpGE_vis_P hP hL hC hS _ (segGuard_mem hu0 hu1) z hz
      rw [bpGEK0_eq] at this
      exact this)
    (fun z hz => by
      rw [← e2]
      have := bpGE_vis_Q hP hL hC hS _ (segGuard_mem hu0' hu1') z hz
      rw [bpGEK1_eq] at this
      exact this)
    (fun z hz => by
      have := pos_on_hull (Q := bpGEZn) (g := (0, 1, -(bpGEK0).2)) (by decide +kernel) z hz
      simp only [Sec5.Corridor.CopyPair.w, bpGECP, intPoint_snd]
      simp only [Irrational.HP.val] at this; push_cast at this; linarith)
    (fun z hz => by rw [bpGECP_L]; exact zero_on_hull (g := ((-310026240000), 4495380480000, (-43846143049728000000))) (by decide +kernel) z hz)
    (fun v h0 h1 => bpGECP_Xmem h0 h1)
  rw [key]
  constructor <;> intro h <;> linarith

/-- **The relation of the unit.**  If the weak-copy nook is covered by the guards `bpGEW u` and
`bpGEA u'` and `Γ` by `bpGEA u'`, `bpGEB v` and the guard of the sum, then `u_C ≤ u_W + u_B`: the weak copy
satisfies `u' ≤ u`, and `Γ` gives the relation for `u'`. -/
theorem bpGE_relation {u u' v w : ℝ} (hu0 : 1 / 2 ≤ u) (hu1 : u ≤ 2) (hu0' : 1 / 2 ≤ u')
    (hu1' : u' ≤ 2) (hv0 : 1 / 2 ≤ v) (hv1 : v ≤ 2) (hw0 : 1 / 2 ≤ w) (hw1 : w ≤ 2)
    (hn : ∀ z ∈ convexHull ℝ (intSet bpGEZn), P.Sees (bpGEW u) z ∨ P.Sees (bpGEA u') z)
    (hg : ∀ z ∈ convexHull ℝ (intSet bpGEZg),
      P.Sees (bpGEA u') z ∨ P.Sees (bpGEB v) z ∨ P.Sees (bpGEC w) z) : w ≤ u + v := by
  have h1 := (bpGE_nook_iff hP hL hC hS hu0 hu1 hu0' hu1').1 hn
  have h2 := (bpGE_gamma_iff hP hL hC hS (u := u') hu0' hu1' hv0 hv1 hw0 hw1).1 hg
  linarith

end Main

end ArtGallery.BP.Tmpl

end
