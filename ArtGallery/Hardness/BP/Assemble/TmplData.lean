/-- The denominator of the integer template coordinates. -/
def tmplDBP : Kind → ℕ
  | .ge => 278400
  | .le => 355200
  | .orient => 278400
  | .inv => 3008974742400

/-- The template chain (integer template coordinates `D · T`). -/
def tmplVBP : Kind → List (ℤ × ℤ)
  | .ge => tmplVGEBP
  | .le => tmplVLEBP
  | .orient => tmplVORBP
  | .inv => tmplVInvBP

/-- The receivers: template left endpoints `T_τ`. -/
def tmplTBP : Kind → List Q2
  | .ge => tmplTGEBP
  | .le => tmplTLEBP
  | .orient => tmplTORBP
  | .inv => tmplTInvBP

/-- The bays of the template: (first chain index, left end point of the segment). -/
def tmplBaysBP : Kind → List (ℕ × Q2)
  | .ge => tmplBaysGEBP
  | .le => tmplBaysLEBP
  | .orient => tmplBaysORBP
  | .inv => tmplBaysInvBP

/-- The template point `T = V / D` of an integer template vertex `V`. -/
def tmplPtBP (k : Kind) (V : ℤ × ℤ) : Q2 := ((V.1 : ℚ) / (tmplDBP k : ℚ), (V.2 : ℚ) / (tmplDBP k : ℚ))

